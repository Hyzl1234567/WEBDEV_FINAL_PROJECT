 {% extends 'dashboard/layout.html.twig' %}

{% block title %}Activity Log Details{% endblock %}

{% block body %}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap');

  :root {
    --forest: #1D4A23;
    --midforest: #2A6132;
    --lime: #99CC67;
    --cream: #F0F7EC;
    --error: #c0392b;
    --success: #27ae60;
  }

  .log-wrap {
    max-width: 1000px;
    margin: 48px auto;
    padding: 0 24px;
    font-family: 'DM Sans', sans-serif;
  }

  /* ── PAGE HEADER ── */
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 2px solid rgba(29,74,35,0.12);
  }

  .page-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 900;
    color: var(--forest);
    margin: 0 0 6px;
  }

  .page-header p {
    font-size: 0.88rem;
    color: var(--midforest);
    opacity: 0.7;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* ── ACTION BADGES ── */
  .action-badge {
    display: inline-block;
    padding: 3px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }

  .action-create  { background: #d4edda; color: #155724; }
  .action-update  { background: #fff3cd; color: #856404; }
  .action-delete  { background: #f8d7da; color: #721c24; }
  .action-login   { background: #cfe2ff; color: #084298; }
  .action-logout  { background: #e2e3e5; color: #383d41; }

  /* ── INFO GRID ── */
  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }

  .info-card {
    background: var(--cream);
    border: 1px solid rgba(29,74,35,0.08);
    border-left: 4px solid var(--forest);
    border-radius: 12px;
    padding: 18px 20px;
    box-shadow: 0 2px 10px rgba(29,74,35,0.05);
  }

  .info-label {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--midforest);
    text-transform: uppercase;
    letter-spacing: 0.7px;
    margin-bottom: 8px;
    opacity: 0.75;
  }

  .info-value {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--forest);
    line-height: 1.4;
  }

  /* ── ROLE BADGE ── */
  .role-badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  .role-admin { background: #fde8e8; color: #c0392b; }
  .role-staff { background: #e0f7f5; color: #1a8a7a; }
  .role-user  { background: var(--cream); color: var(--forest); border: 1px solid rgba(29,74,35,0.15); }

  .ip-mono {
    font-family: monospace;
    background: rgba(29,74,35,0.06);
    padding: 3px 8px;
    border-radius: 5px;
    font-size: 0.95rem;
    color: var(--forest);
  }

  /* ── SECTION CARDS ── */
  .section-card {
    background: var(--cream);
    border: 1px solid rgba(29,74,35,0.08);
    border-radius: 14px;
    padding: 24px 26px;
    margin-bottom: 18px;
    box-shadow: 0 4px 14px rgba(29,74,35,0.06);
  }

  .section-card h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--forest);
    margin: 0 0 14px;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(29,74,35,0.1);
  }

  .description-text {
    font-size: 0.92rem;
    color: #2c3e50;
    line-height: 1.65;
    margin: 0;
  }

  /* ── AFFECTED DATA ROWS ── */
  .data-item {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 11px 0;
    border-bottom: 1px solid rgba(29,74,35,0.06);
  }

  .data-item:last-child { border-bottom: none; }

  .data-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--forest);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    min-width: 130px;
    opacity: 0.75;
  }

  .data-value {
    font-size: 0.9rem;
    color: #2c3e50;
    font-weight: 500;
  }

  /* ── BACK BUTTON ── */
  .log-actions {
    display: flex;
    justify-content: center;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid rgba(29,74,35,0.1);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 22px;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-secondary {
    background: var(--cream);
    color: var(--forest);
    border: 1.5px solid rgba(29,74,35,0.2);
  }

  .btn-secondary:hover {
    background: white;
    border-color: var(--forest);
    transform: translateY(-1px);
  }
</style>

<div class="log-wrap">

  <div class="page-header">
    <div>
      <h1>Activity Log #{{ log.id }}</h1>
      <p>
        Full details for this log entry.
        <span class="action-badge action-{{ log.action|lower }}">{{ log.action }}</span>
      </p>
    </div>
    <a href="{{ path('app_activity_log_index') }}" class="btn btn-secondary">← Back to Logs</a>
  </div>

  {# Info Grid — all rubric fields using dedicated columns #}
  <div class="info-grid">

    <div class="info-card">
      <div class="info-label">Log ID</div>
      <div class="info-value">#{{ log.id }}</div>
    </div>

    {# User ID from relation #}
    <div class="info-card">
      <div class="info-label">User ID</div>
      <div class="info-value">
        {% if log.user %}
          #{{ log.user.id }}
        {% else %}
          <em style="font-size:0.88rem; font-weight:400;">N/A</em>
        {% endif %}
      </div>
    </div>

    {# Username — dedicated column #}
    <div class="info-card">
      <div class="info-label">Username</div>
      <div class="info-value">{{ log.username ?? 'System' }}</div>
    </div>

    {# Role — dedicated column #}
    <div class="info-card">
      <div class="info-label">Role</div>
      <div class="info-value">
        {% if log.role %}
          {% set roleKey = log.role|replace({'ROLE_': ''})|lower %}
          <span class="role-badge role-{{ roleKey }}">
            {{ log.role|replace({'ROLE_': ''}) }}
          </span>
        {% else %}
          <em style="font-size:0.88rem; font-weight:400;">—</em>
        {% endif %}
      </div>
    </div>

    <div class="info-card">
      <div class="info-label">Action</div>
      <div class="info-value">{{ log.action }}</div>
    </div>

    {# Target Data — entity + entityId combined #}
    <div class="info-card">
      <div class="info-label">Target Data</div>
      <div class="info-value" style="font-size:0.95rem;">
        {% if log.entity and log.entityId %}
          {{ log.entity }}: (ID: {{ log.entityId }})
        {% elseif log.entity %}
          {{ log.entity }}
        {% else %}
          <em style="font-size:0.88rem; font-weight:400;">N/A</em>
        {% endif %}
      </div>
    </div>

    {# IP Address #}
    <div class="info-card">
      <div class="info-label">IP Address</div>
      <div class="info-value">
        {% if log.ipAddress %}
          <span class="ip-mono">{{ log.ipAddress }}</span>
        {% else %}
          <em style="font-size:0.88rem; font-weight:400;">N/A</em>
        {% endif %}
      </div>
    </div>

    <div class="info-card">
      <div class="info-label">Date</div>
      <div class="info-value">{{ log.createdAt|date('M d, Y') }}</div>
    </div>

    <div class="info-card">
      <div class="info-label">Time</div>
      <div class="info-value">{{ log.createdAt|date('h:i:s A') }}</div>
    </div>

  </div>

  {# Description — now shows human-readable sentence #}
  {% if log.description %}
  <div class="section-card">
    <h3>Description</h3>
    <p class="description-text">{{ log.description }}</p>
  </div>
  {% endif %}

  {# Affected Data #}
  {% if log.entity and log.entityId %}
  <div class="section-card">
    <h3>Affected Data</h3>
    <div class="data-item">
      <span class="data-label">Entity Type</span>
      <span class="data-value">{{ log.entity }}</span>
    </div>
    <div class="data-item">
      <span class="data-label">Entity ID</span>
      <span class="data-value">#{{ log.entityId }}</span>
    </div>
    <div class="data-item">
      <span class="data-label">Action</span>
      <span class="data-value">{{ log.action }}</span>
    </div>
    <div class="data-item">
      <span class="data-label">Performed By</span>
      <span class="data-value">
        {{ log.username ?? 'System' }}
        {% if log.role %}
          ({{ log.role|replace({'ROLE_': ''}) }})
        {% endif %}
      </span>
    </div>
    {% if log.ipAddress %}
    <div class="data-item">
      <span class="data-label">IP Address</span>
      <span class="data-value"><span class="ip-mono">{{ log.ipAddress }}</span></span>
    </div>
    {% endif %}
  </div>
  {% endif %}

  <div class="log-actions">
    <a href="{{ path('app_activity_log_index') }}" class="btn btn-secondary">← Back to Logs</a>
  </div>

</div>
{% endblock %}
