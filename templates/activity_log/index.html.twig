 {% extends 'dashboard/layout.html.twig' %}

{% block title %}System Activity Logs{% endblock %}

{% block body %}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap');

  :root {
    --forest: #1D4A23;
    --midforest: #2A6132;
    --lime: #99CC67;
    --cream: #F0F7EC;
    --error: #c0392b;
    --success: #27ae60;
  }

  .logs-wrap {
    max-width: 1600px;
    margin: 36px auto;
    padding: 0 24px;
    font-family: 'DM Sans', sans-serif;
  }

  /* ── PAGE HEADER ── */
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 2px solid rgba(29,74,35,0.12);
  }

  .page-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 900;
    color: var(--forest);
    margin: 0 0 4px;
  }

  .page-header p {
    font-size: 0.88rem;
    color: var(--midforest);
    opacity: 0.7;
    margin: 0;
  }

  .header-actions { display: flex; gap: 10px; align-items: center; }

  /* ── STAT CARDS ── */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 16px;
    margin-bottom: 24px;
  }

  .stat-card {
    background: var(--cream);
    border: 1px solid rgba(29,74,35,0.08);
    border-radius: 14px;
    padding: 20px 18px;
    text-align: center;
    box-shadow: 0 4px 14px rgba(29,74,35,0.06);
  }

  .stat-number {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 900;
    color: var(--forest);
    line-height: 1;
    margin-bottom: 6px;
  }

  .stat-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--midforest);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    opacity: 0.75;
  }

  /* ── FILTER SECTION ── */
  .filter-card {
    background: var(--cream);
    border: 1px solid rgba(29,74,35,0.08);
    border-radius: 14px;
    padding: 22px 24px;
    margin-bottom: 24px;
    box-shadow: 0 4px 14px rgba(29,74,35,0.06);
  }

  .filter-card-title {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--forest);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    margin-bottom: 16px;
  }

  .filter-form {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 14px;
    align-items: end;
  }

  .filter-group { display: flex; flex-direction: column; gap: 6px; }

  .filter-group label {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--forest);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .filter-group select,
  .filter-group input {
    padding: 9px 12px;
    border: 1.5px solid rgba(29,74,35,0.2);
    border-radius: 9px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem;
    background: white;
    color: #2c3e50;
    outline: none;
    transition: border-color 0.2s;
  }

  .filter-group select:focus,
  .filter-group input:focus {
    border-color: var(--lime);
    box-shadow: 0 0 0 3px rgba(153,204,103,0.15);
  }

  .filter-actions { display: flex; gap: 8px; align-items: flex-end; }

  /* ── TABLE CARD ── */
  .table-card {
    background: var(--cream);
    border-radius: 16px;
    border: 1px solid rgba(29,74,35,0.08);
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(29,74,35,0.07);
  }

  .table {
    width: 100%;
    border-collapse: collapse;
    background: var(--cream);
  }

  .table thead { background: var(--forest); }

  .table th {
    padding: 14px 16px;
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(255,255,255,0.85);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    text-align: left;
  }

  .table td {
    padding: 13px 16px;
    font-size: 0.87rem;
    color: #2c3e50;
    border-bottom: 1px solid rgba(29,74,35,0.06);
    background: var(--cream);
    vertical-align: middle;
  }

  .table tbody tr:last-child td { border-bottom: none; }

  .table tbody tr:hover td {
    background: #e4f0da;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  /* ── ACTION BADGES ── */
  .action-badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }

  .action-create  { background: #d4edda; color: #155724; }
  .action-update  { background: #fff3cd; color: #856404; }
  .action-delete  { background: #f8d7da; color: #721c24; }
  .action-login   { background: #cfe2ff; color: #084298; }
  .action-logout  { background: #e2e3e5; color: #383d41; }

  /* ── INLINE BADGES ── */
  .role-badge {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    background: rgba(29,74,35,0.08);
    color: var(--forest);
    margin: 1px;
  }

  .entity-badge {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    background: #ecf0f1;
    color: #2c3e50;
  }

  .target-badge {
    display: inline-block;
    padding: 3px 8px;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    background: #fff3cd;
    color: #856404;
  }

  /* ── BUTTONS ── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 9px 18px;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: var(--forest);
    color: white;
    box-shadow: 0 4px 14px rgba(29,74,35,0.2);
  }
  .btn-primary:hover {
    background: var(--midforest);
    transform: translateY(-1px);
  }

  .btn-secondary {
    background: var(--cream);
    color: var(--forest);
    border: 1.5px solid rgba(29,74,35,0.2);
  }
  .btn-secondary:hover {
    background: white;
    border-color: var(--forest);
  }

  .btn-export {
    background: var(--lime);
    color: var(--forest);
  }
  .btn-export:hover {
    background: #b6df8a;
    transform: translateY(-1px);
  }

  .btn-sm {
    padding: 5px 14px;
    font-size: 0.78rem;
    border-radius: 8px;
  }

  /* ── EMPTY STATE ── */
  .no-logs {
    text-align: center;
    padding: 56px 20px;
    color: #999;
    font-style: italic;
    font-size: 0.9rem;
    background: var(--cream);
  }
</style>

<div class="logs-wrap">

  <div class="page-header">
    <div>
      <h1>Activity Logs</h1>
      <p>Full audit trail of system actions across EcoBrew.</p>
    </div>
    <div class="header-actions">
      <!-- <a href="{{ path('app_activity_log_export', current_filters) }}" class="btn btn-export">📥 Export CSV</a> -->
      <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">← Back</a>
    </div>
  </div>

  <!-- Statistics -->
  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-number">{{ logs|length }}</div>
      <div class="stat-label">Total Results</div>
    </div>
    <div class="stat-card">
      <div class="stat-number">{{ logs|filter(l => l.action == 'create')|length }}</div>
      <div class="stat-label">Created</div>
    </div>
    <div class="stat-card">
      <div class="stat-number">{{ logs|filter(l => l.action == 'update')|length }}</div>
      <div class="stat-label">Updated</div>
    </div>
    <div class="stat-card">
      <div class="stat-number">{{ logs|filter(l => l.action == 'delete')|length }}</div>
      <div class="stat-label">Deleted</div>
    </div>
    <div class="stat-card">
      <div class="stat-number">{{ logs|filter(l => l.action == 'login')|length }}</div>
      <div class="stat-label">Logins</div>
    </div>
  </div>

  <!-- Filters -->
  <div class="filter-card">
    <div class="filter-card-title">Filter Logs</div>
    <form method="get" class="filter-form">
      <div class="filter-group">
        <label for="user">User</label>
        <select name="user" id="user">
          <option value="">All Users</option>
          {% for u in users %}
            <option value="{{ u.id }}" {% if current_filters.user and current_filters.user == u.id %}selected{% endif %}>
              {{ u.username }}
            </option>
          {% endfor %}
        </select>
      </div>

      <div class="filter-group">
        <label for="action">Action</label>
        <select name="action" id="action">
          <option value="">All Actions</option>
          {% for act in actions %}
            <option value="{{ act.action }}" {% if current_filters.action == act.action %}selected{% endif %}>
              {{ act.action|capitalize }}
            </option>
          {% endfor %}
        </select>
      </div>

      <div class="filter-group">
        <label for="entity">Entity</label>
        <select name="entity" id="entity">
          <option value="">All Entities</option>
          {% for ent in entities %}
            <option value="{{ ent.entity }}" {% if current_filters.entity == ent.entity %}selected{% endif %}>
              {{ ent.entity }}
            </option>
          {% endfor %}
        </select>
      </div>

      <div class="filter-group">
        <label for="start_date">Start Date</label>
        <input type="date" name="start_date" id="start_date" value="{{ current_filters.start_date }}">
      </div>

      <div class="filter-group">
        <label for="end_date">End Date</label>
        <input type="date" name="end_date" id="end_date" value="{{ current_filters.end_date }}">
      </div>

      <div class="filter-actions">
        <button type="submit" class="btn btn-primary">🔍 Apply</button>
        <a href="{{ path('app_activity_log_index') }}" class="btn btn-secondary">Clear</a>
      </div>
    </form>
  </div>

  <!-- Logs Table -->
  <div class="table-card">
    <table class="table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Username</th>
          <th>Role</th>
          <th>Action</th>
          <th>Entity</th>
          <th>Target</th>
          <th>Description</th>
          <th>Timestamp</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% if logs|length > 0 %}
          {% for log in logs %}
            <tr onclick="window.location.href='{{ path('app_activity_log_show', {id: log.id}) }}'">
              <td><strong>#{{ log.id }}</strong></td>
              <td>
                <strong>{{ log.username ?? (log.user ? log.user.username : 'System') }}</strong>
                {% if log.user %}
                  <br><small style="color:#aaa;">#{{ log.user.id }}</small>
                {% endif %}
              </td>
              <td>
                {% if log.role %}
                  <span class="role-badge">{{ log.role|replace({'ROLE_': ''}) }}</span>
                {% elseif log.user %}
                  {% for role in log.user.roles %}
                    {% if role != 'ROLE_USER' %}
                      <span class="role-badge">{{ role|replace({'ROLE_': ''}) }}</span>
                    {% endif %}
                  {% endfor %}
                {% else %}
                  —
                {% endif %}
              </td>
              <td>
                <span class="action-badge action-{{ log.action }}">{{ log.action }}</span>
              </td>
              <td>
                {% if log.entity %}
                  <span class="entity-badge">{{ log.entity }}</span>
                {% else %}—{% endif %}
              </td>
              <td>
                {% if log.description %}
                  <span class="target-badge">{{ log.description|slice(0, 40) }}{% if log.description|length > 40 %}...{% endif %}</span>
                {% else %}—{% endif %}
              </td>
              <td style="color:#666; font-size:0.83rem;">
                {{ log.description|slice(0, 50) }}{% if log.description|length > 50 %}...{% endif %}
              </td>
              <td style="white-space: nowrap; font-size:0.83rem; color:#777;">
                {{ log.createdAt|date('M d, Y H:i:s') }}
              </td>
              <td>
                <a href="{{ path('app_activity_log_show', {id: log.id}) }}" class="btn btn-primary btn-sm" onclick="event.stopPropagation();">
                  View
                </a>
              </td>
            </tr>
          {% endfor %}
        {% else %}
          <tr>
            <td colspan="10" class="no-logs">No activity logs found matching your filters.</td>
          </tr>
        {% endif %}
      </tbody>
    </table>
  </div>

</div>
{% endblock %}
