 {% extends 'dashboard/layout.html.twig' %}

{% block title %}Edit Order{% endblock %}

{% block body %}
<style>
  :root {
    --cream: #F0F7EC;
    --forest: #1D4A23;
    --darkforest: #142E17;
    --midforest: #2A6132;
    --lime: #99CC67;
    --limelight: #B8DC8E;
    --paper: #F5FAF2;
  }

  .form-page {
    min-height: 100vh;
    background: var(--cream);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 100px 1.5rem 3rem;
  }

  .form-card {
    width: 100%;
    max-width: 800px;
    background: white;
    border-radius: 22px;
    box-shadow: 0 8px 48px rgba(29,74,35,0.12);
    overflow: hidden;
  }

  /* ── Card Header ── */
  .form-card-header {
    background: var(--forest);
    padding: 2rem 2.5rem 1.75rem;
  }

  .form-card-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    font-weight: 900;
    color: white;
    margin-bottom: 0.25rem;
  }

  .form-card-header p {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    color: rgba(240,247,236,0.6);
  }

  /* ── Card Body ── */
  .form-card-body {
    padding: 2rem 2.5rem;
  }

  /* ── Alerts ── */
  .alert {
    padding: 11px 16px;
    border-radius: 10px;
    margin-bottom: 1.1rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .alert-success {
    background: rgba(153,204,103,0.18);
    color: var(--forest);
    border: 1px solid rgba(153,204,103,0.45);
  }

  .alert-danger {
    background: rgba(192,57,43,0.08);
    color: #c0392b;
    border: 1px solid rgba(192,57,43,0.2);
  }

  /* ── Form Groups ── */
  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-group label,
  label {
    display: block;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--forest);
    margin-bottom: 0.45rem;
    letter-spacing: 0.3px;
  }

  /* ── Inputs ── */
  .form-control,
  input,
  textarea,
  select {
    width: 100%;
    padding: 12px 16px;
    border: 1.5px solid rgba(29,74,35,0.2);
    border-radius: 10px;
    background: var(--paper);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    color: var(--forest);
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
  }

  .form-control:focus,
  input:focus,
  textarea:focus,
  select:focus {
    border-color: var(--lime);
    box-shadow: 0 0 0 3px rgba(153,204,103,0.18);
    background: white;
  }

  .form-control:hover {
    border-color: rgba(29,74,35,0.35);
  }

  /* ── Form Errors ── */
  .form-error {
    font-family: 'DM Sans', sans-serif;
    color: #c0392b;
    font-size: 0.8rem;
    margin-top: 0.3rem;
  }

  /* ── Update Actions Row ── */
  .form-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1.5px solid rgba(29,74,35,0.08);
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .form-actions-left {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  /* ── Delete Zone ── */
  .delete-zone {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1.5px dashed rgba(192,57,43,0.2);
    display: flex;
    justify-content: flex-end;
  }

  /* ── Buttons ── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 11px 24px;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
    letter-spacing: 0.15px;
  }

  .btn-primary {
    background: var(--forest);
    color: white;
    box-shadow: 0 4px 18px rgba(29,74,35,0.22);
  }

  .btn-primary:hover {
    background: var(--lime);
    color: var(--forest);
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(153,204,103,0.35);
  }

  .btn-secondary {
    background: transparent;
    color: var(--midforest);
    border: 1.5px solid rgba(29,74,35,0.25);
  }

  .btn-secondary:hover {
    background: var(--forest);
    color: white;
    border-color: var(--forest);
  }

  .btn-danger {
    background: rgba(192,57,43,0.08);
    color: #c0392b;
    border: 1.5px solid rgba(192,57,43,0.25);
  }

  .btn-danger:hover {
    background: #c0392b;
    color: white;
    border-color: #c0392b;
    transform: translateY(-1px);
  }

  .delete-form { display: inline; margin: 0; }
</style>

<div class="form-page">
  <div class="form-card">

    <div class="form-card-header">
      <h1>✏️ Edit Order #{{ order.id }}</h1>
      <p>Update the order details below</p>
    </div>

    <div class="form-card-body">

      {% for message in app.flashes('success') %}
        <div class="alert alert-success">✓ {{ message }}</div>
      {% endfor %}
      {% for message in app.flashes('error') %}
        <div class="alert alert-danger">⚠ {{ message }}</div>
      {% endfor %}

      {{ form_start(form) }}

        <div class="form-group">
          {{ form_label(form.customer) }}
          {{ form_widget(form.customer, {'attr': {'class': 'form-control'}}) }}
          {{ form_errors(form.customer) }}
        </div>

        <div class="form-group">
          {{ form_label(form.product) }}
          {{ form_widget(form.product, {'attr': {'class': 'form-control'}}) }}
          {{ form_errors(form.product) }}
        </div>

        <div class="form-group">
          {{ form_label(form.quantity) }}
          {{ form_widget(form.quantity, {'attr': {'class': 'form-control'}}) }}
          {{ form_errors(form.quantity) }}
        </div>

        <div class="form-group">
          {{ form_label(form.status) }}
          {{ form_widget(form.status, {'attr': {'class': 'form-control'}}) }}
          {{ form_errors(form.status) }}
        </div>

        {{ form_rest(form) }}

        <div class="form-actions">
          <div class="form-actions-left">
            <button type="submit" class="btn btn-primary">💾 Update Order</button>
            <a href="{{ path('app_order_index') }}" class="btn btn-secondary">← Back to List</a>
          </div>
        </div>

      {{ form_end(form) }}

      {# Delete form is outside the update form #}
      {% set canDelete = is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}

      {% if canDelete %}
        <div class="delete-zone">
          <form method="post" action="{{ path('app_order_delete', {'id': order.id}) }}" class="delete-form" id="deleteOrderForm">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ order.id) }}">
            <button type="button" class="btn btn-danger" id="deleteOrderButton">🗑️ Delete Order</button>
          </form>
        </div>
      {% endif %}

    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const deleteButton = document.getElementById('deleteOrderButton');
    const deleteForm = document.getElementById('deleteOrderForm');

    if (deleteButton && deleteForm) {
        deleteButton.addEventListener('click', function(e) {
            e.preventDefault();

            const orderId = "{{ order.id }}";
            const customerName = "{{ order.customer|escape('js') }}";
            const productName = "{{ order.product ? order.product.name|escape('js') : 'N/A' }}";
            const totalPrice = "{{ order.totalPrice|number_format(2) }}";

            const confirmMessage = `⚠️ WARNING: DELETE CONFIRMATION

Are you ABSOLUTELY SURE you want to delete this order?

Order ID: #${orderId}
Customer: ${customerName}
Product: ${productName}
Total: ₱${totalPrice}

⚠️ THIS ACTION CANNOT BE UNDONE!

Click OK to DELETE, or Cancel to keep the order.`;

            if (confirm(confirmMessage)) {
                deleteForm.submit();
            }
        });
    }
});
</script>
{% endblock %}
