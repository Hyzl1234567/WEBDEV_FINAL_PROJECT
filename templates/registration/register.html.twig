 
{% extends 'landingPage/base.html.twig' %}

{% block title %}Register – EcoBrew Café{% endblock %}

{% block extra_styles %}
.auth-wrap {
  min-height: calc(100vh - 70px);
  display: grid; grid-template-columns: 1fr 1fr;
  margin-top: 70px;
}
.auth-visual {
  background: linear-gradient(160deg, var(--midforest) 0%, var(--forest) 60%, var(--darkforest) 100%);
  display: flex; flex-direction: column;
  justify-content: center; align-items: center;
  padding: 4rem;
  position: relative; overflow: hidden;
}
.auth-visual::before {
  content: '';
  position: absolute; top: -150px; left: -150px;
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(153,204,103,0.15) 0%, transparent 70%);
  border-radius: 50%;
}
.auth-visual::after {
  content: '';
  position: absolute; bottom: -100px; right: -100px;
  width: 300px; height: 300px;
  background: radial-gradient(circle, rgba(153,204,103,0.08) 0%, transparent 70%);
  border-radius: 50%;
}
.auth-visual-title {
  font-family: 'Playfair Display', serif;
  font-size: 2.5rem; font-weight: 900;
  color: white; text-align: center; line-height: 1.2;
  margin-bottom: 1rem; position: relative; z-index: 1;
}
.auth-visual-sub {
  color: rgba(255,255,255,0.65); text-align: center;
  font-size: 1rem; line-height: 1.65;
  max-width: 300px; position: relative; z-index: 1;
}
.auth-big-emoji { font-size: 5rem; margin-bottom: 1.5rem; display: block; position: relative; z-index: 1; }

.auth-perks {
  display: flex; flex-direction: column; gap: 0.85rem;
  margin-top: 2rem; position: relative; z-index: 1; width: 100%; max-width: 280px;
}
.auth-perk {
  display: flex; align-items: center; gap: 0.75rem;
  color: rgba(255,255,255,0.8); font-size: 0.88rem;
}
.auth-perk-icon {
  width: 32px; height: 32px; border-radius: 8px;
  background: rgba(153,204,103,0.2);
  display: flex; align-items: center; justify-content: center;
  font-size: 1rem; flex-shrink: 0;
}

.auth-form-wrap {
  display: flex; flex-direction: column;
  justify-content: center; align-items: center;
  padding: 4rem;
  background: var(--paper);
  overflow-y: auto;
}
.auth-form-inner { width: 100%; max-width: 420px; }
.auth-form-inner h2 {
  font-family: 'Playfair Display', serif;
  font-size: 2rem; font-weight: 800;
  color: var(--forest); margin-bottom: 0.4rem;
}
.auth-form-inner .sub {
  color: var(--midforest); opacity: 0.75; font-size: 0.9rem; margin-bottom: 2rem;
}

.password-hint {
  background: rgba(153,204,103,0.1);
  border: 1px solid rgba(153,204,103,0.25);
  border-radius: 8px;
  padding: 10px 14px;
  margin-top: 8px;
  font-size: 0.82rem;
  color: var(--midforest);
}
.password-hint strong { color: var(--forest); display: block; margin-bottom: 4px; }
.password-hint ul { margin: 0 0 0 16px; padding: 0; }
.password-hint ul li { margin: 2px 0; }

.auth-switch { text-align: center; font-size: 0.88rem; color: var(--midforest); margin-top: 1.5rem; }
.auth-switch a { color: var(--forest); font-weight: 600; text-decoration: none; }
.auth-switch a:hover { color: var(--limeshadow); text-decoration: underline; }

.alert { padding: 12px 15px; border-radius: 8px; margin-bottom: 1.25rem; font-size: 0.9rem; font-weight: 500; }
.alert-error {
  background: rgba(192,57,43,0.08); color: var(--error);
  border-left: 4px solid var(--error);
}
.alert-success {
  background: rgba(39,174,96,0.1); color: var(--success);
  border-left: 4px solid var(--success);
}

@media (max-width: 900px) {
  .auth-wrap { grid-template-columns: 1fr; }
  .auth-visual { display: none; }
  .auth-form-wrap { padding: 2.5rem 1.5rem; }
}
{% endblock %}

{% block body %}
<div class="auth-wrap">

  {# Left visual panel #}
  <div class="auth-visual">
    <span class="auth-big-emoji">🌱</span>
    <div class="auth-visual-title">Join the<br>EcoBrew<br>Family</div>
    <div class="auth-visual-sub">Create an account and start earning loyalty points on every sustainable sip.</div>
    <div class="auth-perks">
      <div class="auth-perk">
        <div class="auth-perk-icon">☕</div>
        <span>Earn points on every order</span>
      </div>
      <div class="auth-perk">
        <div class="auth-perk-icon">🌍</div>
        <span>Track your eco impact</span>
      </div>
      <div class="auth-perk">
        <div class="auth-perk-icon">🎁</div>
        <span>Exclusive member rewards</span>
      </div>
    </div>
  </div>

  {# Register form #}
  <div class="auth-form-wrap">
    <div class="auth-form-inner">
      <h2>Create Account</h2>
      <p class="sub">Join thousands of eco-conscious coffee lovers.</p>

      {% for message in app.flashes('error') %}
        <div class="alert alert-error">{{ message }}</div>
      {% endfor %}

      {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
      {% endfor %}

      <form method="post">
        <div class="form-group">
          <label for="username">Username</label>
          <input
            type="text"
            id="username"
            name="username"
            placeholder="e.g. juandelacruz"
            value="{{ username ?? '' }}"
            required
            autocomplete="username">
        </div>

        <div class="form-group">
          <label for="email">Email Address</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="juan@email.com"
            value="{{ email ?? '' }}"
            required
            autocomplete="email">
        </div>

        <div class="form-group">
          <label for="full_name">Full Name</label>
          <input
            type="text"
            id="full_name"
            name="full_name"
            placeholder="Juan dela Cruz"
            value="{{ full_name ?? '' }}"
            required
            autocomplete="name">
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="Min. 6 characters"
            required
            autocomplete="new-password">
          <div class="password-hint">
            <strong>Requirements</strong>
            <ul>
              <li>Minimum 6 characters</li>
              <li>Mix of letters and numbers recommended</li>
            </ul>
          </div>
        </div>

        <div class="form-group">
          <label for="confirm_password">Confirm Password</label>
          <input
            type="password"
            id="confirm_password"
            name="confirm_password"
            placeholder="Repeat your password"
            required
            autocomplete="new-password">
        </div>

        <div class="form-group" style="display:flex;align-items:flex-start;gap:10px;margin-top:0.25rem;">
          <input type="checkbox" id="terms" name="terms" style="width:auto;margin-top:3px;" required>
          <label for="terms" style="font-size:0.83rem;color:var(--midforest);opacity:0.85;font-weight:400;">
            I agree to the <a href="#" style="color:var(--forest);font-weight:600;">Terms of Service</a> and <a href="#" style="color:var(--forest);font-weight:600;">Privacy Policy</a>
          </label>
        </div>

        <button type="submit" class="btn-full" style="margin-top:0.5rem;">
          Create Account →
        </button>
      </form>

      <div class="auth-switch">
        Already have an account? <a href="{{ path('app_login') }}">Sign in here</a>
      </div>
    </div>
  </div>

</div>
{% endblock %}
