{% extends 'base.html.twig' %}

{% block title %}Stock Details{% endblock %}

{% block body %}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap');

  :root {
    --forest: #1D4A23;
    --midforest: #2A6132;
    --lime: #99CC67;
    --cream: #F0F7EC;
    --paper: #F0F7EC;
    --error: #c0392b;
  }

  .show-wrap {
    min-height: calc(100vh - 70px);
    background: var(--paper);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    padding: 48px 20px;
    font-family: 'DM Sans', sans-serif;
    gap: 28px;
  }

  /* ── SPLIT CARD ── */
  .stock-card {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    max-width: 860px;
    width: 100%;
    background: var(--cream);
    border-radius: 20px;
    border: 1px solid rgba(29,74,35,0.1);
    box-shadow: 0 8px 40px rgba(29,74,35,0.09);
    overflow: hidden;
  }

  /* ── LEFT — image panel ── */
  .stock-left {
    background: linear-gradient(160deg, var(--forest), var(--midforest));
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 28px;
    position: relative;
    overflow: hidden;
  }

  .stock-left::before {
    content: '';
    position: absolute;
    top: -80px; left: -80px;
    width: 240px; height: 240px;
    background: radial-gradient(circle, rgba(153,204,103,0.15) 0%, transparent 70%);
    border-radius: 50%;
  }

  .stock-left img {
    max-width: 100%;
    max-height: 280px;
    border-radius: 14px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.25);
    position: relative;
    z-index: 1;
  }

  .no-image {
    color: rgba(255,255,255,0.45);
    font-size: 0.9rem;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  /* ── RIGHT — details panel ── */
  .stock-right {
    padding: 36px 32px;
  }

  .stock-right h2 {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    font-weight: 900;
    color: var(--forest);
    margin: 0 0 6px;
  }

  .stock-right .sub {
    font-size: 0.85rem;
    color: var(--midforest);
    opacity: 0.65;
    margin: 0 0 24px;
  }

  /* ── DETAIL ROWS ── */
  .detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 0;
    border-bottom: 1px solid rgba(29,74,35,0.07);
    font-size: 0.88rem;
  }

  .detail-row:last-of-type { border-bottom: none; }

  .detail-label {
    font-weight: 600;
    color: var(--midforest);
    opacity: 0.8;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    min-width: 120px;
  }

  .detail-value {
    color: #2c3e50;
    font-weight: 400;
    text-align: right;
  }

  .quantity-value {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--forest);
  }

  /* ── BADGES ── */
  .badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  .badge-admin   { background: #fde8e8; color: #c0392b; }
  .badge-staff   { background: #e0f7f5; color: #1a8a7a; }
  .badge-unknown { background: #e2e3e5; color: #383d41; }

  /* ── ACTIONS ── */
  .stock-actions {
    display: flex;
    gap: 10px;
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid rgba(29,74,35,0.1);
    flex-wrap: wrap;
  }

  .btn {
    flex: 1;
    padding: 11px 16px;
    border-radius: 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    transition: all 0.2s ease;
    display: inline-block;
    min-width: 90px;
  }

  .btn-back {
    background: white;
    color: var(--forest);
    border: 1.5px solid rgba(29,74,35,0.15);
  }

  .btn-back:hover { border-color: var(--lime); background: #e8f5e0; }

  .btn-danger {
    background: #fdecea;
    color: var(--error);
    border: 1.5px solid #f5c6c6;
  }

  .btn-danger:hover { background: #f5c6c6; }

  .delete-form { display: inline; flex: 1; }

  /* ── WARNING ── */
  .warning-message {
    background: #fff9e6;
    border: 1px solid #ffe08a;
    border-radius: 10px;
    padding: 12px 16px;
    color: #856404;
    font-size: 0.82rem;
    margin-top: 16px;
    line-height: 1.5;
  }

  /* ── HISTORY TABLE ── */
  .history-card {
    max-width: 860px;
    width: 100%;
    background: var(--cream);
    border-radius: 20px;
    border: 1px solid rgba(29,74,35,0.1);
    box-shadow: 0 8px 40px rgba(29,74,35,0.09);
    overflow: hidden;
  }

  .history-header {
    padding: 20px 28px 16px;
    border-bottom: 1px solid rgba(29,74,35,0.08);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .history-header h3 {
    font-family: 'Playfair Display', serif;
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--forest);
    margin: 0;
  }

  .history-count {
    background: rgba(29,74,35,0.08);
    color: var(--midforest);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 2px 9px;
    border-radius: 20px;
  }

  .history-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.86rem;
    font-family: 'DM Sans', sans-serif;
  }

  .history-table thead th {
    background: rgba(29,74,35,0.05);
    color: var(--midforest);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
    padding: 10px 20px;
    text-align: left;
    border-bottom: 1px solid rgba(29,74,35,0.08);
  }

  .history-table tbody tr {
    border-bottom: 1px solid rgba(29,74,35,0.06);
    transition: background 0.15s;
  }

  .history-table tbody tr:last-child { border-bottom: none; }
  .history-table tbody tr:hover { background: rgba(153,204,103,0.07); }

  .history-table td {
    padding: 12px 20px;
    color: #2c3e50;
    vertical-align: middle;
  }

  .qty-added {
    font-weight: 700;
    color: var(--forest);
    font-size: 1rem;
  }

  .history-empty {
    text-align: center;
    padding: 32px 20px;
    color: var(--midforest);
    opacity: 0.5;
    font-size: 0.88rem;
  }

  @media (max-width: 700px) {
    .stock-card { grid-template-columns: 1fr; }
    .stock-left { min-height: 200px; }
    .history-table thead { display: none; }
    .history-table td {
      display: block;
      padding: 6px 16px;
    }
    .history-table tr {
      display: block;
      padding: 10px 0;
      border-bottom: 1px solid rgba(29,74,35,0.08);
    }
  }
</style>

<div class="show-wrap">
  <div class="stock-card">

    {# Left — image #}
    <div class="stock-left">
      {% if stock.product and stock.product.image %}
        <img src="{{ asset('uploads/images/' ~ stock.product.image) }}" alt="{{ stock.product.name }}">
      {% else %}
        <div class="no-image">No image available</div>
      {% endif %}
    </div>

    {# Right — details #}
    <div class="stock-right">
      <h2>Stock Details</h2>
      <p class="sub">Record #{{ stock.id }}</p>

      <div class="detail-row">
        <span class="detail-label">Stock ID</span>
        <span class="detail-value">#{{ stock.id }}</span>
      </div>

      <div class="detail-row">
        <span class="detail-label">Product</span>
        <span class="detail-value"><strong>{{ stock.product ? stock.product.name : 'Unknown' }}</strong></span>
      </div>

      <div class="detail-row">
        <span class="detail-label">Quantity</span>
        <span class="detail-value quantity-value">{{ stock.quantity }}</span>
      </div>

      <div class="detail-row">
        <span class="detail-label">Last Updated</span>
        <span class="detail-value">{{ stock.lastUpdated ? stock.lastUpdated|date('M d, Y — H:i') : '—' }}</span>
      </div>

      <div class="detail-row">
        <span class="detail-label">Created At</span>
        <span class="detail-value">{{ stock.createdAt ? stock.createdAt|date('M d, Y — H:i') : '—' }}</span>
      </div>

      <div class="detail-row">
        <span class="detail-label">Created By</span>
        <span class="detail-value">
          {% if stock.createdBy %}
            <span class="badge {{ 'ROLE_ADMIN' in stock.createdBy.roles ? 'badge-admin' : 'badge-staff' }}">
              {{ 'ROLE_ADMIN' in stock.createdBy.roles ? 'Admin' : 'Staff' }} — {{ stock.createdBy.username }}
            </span>
          {% else %}
            <span class="badge badge-unknown">Unknown</span>
          {% endif %}
        </span>
      </div>

      {# Actions — edit button removed #}
      {% set canDelete = is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}

      <div class="stock-actions">
        <a href="{{ path('app_stock_index') }}" class="btn btn-back">← Back</a>

        {% if canDelete %}
          <form method="post" action="{{ path('app_stock_delete', {'id': stock.id}) }}" class="delete-form"
                onsubmit="return confirm('Delete stock for {{ stock.product ? stock.product.name : 'Unknown' }} (Qty: {{ stock.quantity }})? This cannot be undone.');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ stock.id) }}">
            <button type="submit" class="btn btn-danger">Delete</button>
          </form>
        {% endif %}
      </div>

      {% if not canDelete %}
        <div class="warning-message">
          🔒 You do not have permission to delete this record. This stock was created by
          <strong>{{ stock.createdBy ? stock.createdBy.username : 'another user' }}</strong>.
        </div>
      {% endif %}

    </div>
  </div>

  {# Stock History for this product #}
  <div class="history-card">
    <div class="history-header">
      <h3>📦 Stock History — {{ stock.product ? stock.product.name : 'This Product' }}</h3>
      <span class="history-count">{{ stockHistory|length }} record{{ stockHistory|length != 1 ? 's' : '' }}</span>
    </div>

    {% if stockHistory is not empty %}
      <table class="history-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Date Added</th>
            <th>Qty Added</th>
            <th>Added By</th>
          </tr>
        </thead>
        <tbody>
          {% for entry in stockHistory %}
            <tr>
              <td style="opacity:0.45;">{{ loop.index }}</td>
              <td>{{ entry.createdAt ? entry.createdAt|date('M d, Y — H:i') : '—' }}</td>
              <td><span class="qty-added">+{{ entry.quantity }}</span></td>
              <td>
                {% if entry.createdBy %}
                  <span class="badge {{ 'ROLE_ADMIN' in entry.createdBy.roles ? 'badge-admin' : 'badge-staff' }}">
                    {{ 'ROLE_ADMIN' in entry.createdBy.roles ? 'Admin' : 'Staff' }} — {{ entry.createdBy.username }}
                  </span>
                {% else %}
                  <span class="badge badge-unknown">Unknown</span>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <div class="history-empty">No stock history found for this product.</div>
    {% endif %}
  </div>

</div>
{% endblock %}