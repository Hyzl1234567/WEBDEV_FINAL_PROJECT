{% extends 'dashboard/layout.html.twig' %}

{% block title %}Stock Inventory{% endblock %}

{% block body %}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap');

  :root {
    --forest: #1D4A23;
    --midforest: #2A6132;
    --lime: #99CC67;
    --cream: #F0F7EC;
    --paper: #F0F7EC;
    --error: #c0392b;
    --success: #27ae60;
  }

  .content-wrapper {
    max-width: 1300px;
    margin: 36px auto;
    padding: 0 24px;
    font-family: 'DM Sans', sans-serif;
  }

  /* ── PAGE HEADER ── */
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 2px solid rgba(29,74,35,0.12);
  }

  .page-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 900;
    color: var(--forest);
    margin: 0 0 4px;
  }

  .page-header p {
    font-size: 0.88rem;
    color: var(--midforest);
    opacity: 0.7;
    margin: 0;
  }

  /* ── FLASH ── */
  .flash-success {
    background: rgba(39,174,96,0.1);
    border-left: 4px solid var(--success);
    color: var(--success);
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 500;
    margin-bottom: 16px;
  }

  .flash-error {
    background: rgba(192,57,43,0.08);
    border-left: 4px solid var(--error);
    color: var(--error);
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 0.88rem;
    font-weight: 500;
    margin-bottom: 16px;
  }

  /* ── TABLE CARD ── */
  .table-card {
    background: var(--cream);
    border-radius: 16px;
    border: 1px solid rgba(29,74,35,0.08);
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(29,74,35,0.07);
  }

  .table {
    width: 100% !important;
    border-collapse: collapse;
    background: var(--cream);
  }

  .table thead {
    background: var(--forest);
  }

  .table thead th {
    padding: 14px 18px;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(255,255,255,0.85);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    text-align: left;
  }

  .table tbody td {
    padding: 14px 18px;
    font-size: 0.88rem;
    color: #2c3e50;
    border-bottom: 1px solid rgba(29,74,35,0.06);
    vertical-align: middle;
    background: var(--cream);
  }

  .table tbody tr:last-child td { border-bottom: none; }

  .table tbody tr:hover td {
    background: #e4f0da;
    transition: background 0.2s ease;
  }

  .table img {
    width: 64px;
    height: 64px;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid rgba(29,74,35,0.1);
  }

  /* ── BADGES ── */
  .badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  .badge-admin   { background: #fde8e8; color: #c0392b; }
  .badge-staff   { background: #e0f7f5; color: #1a8a7a; }
  .badge-unknown { background: #e2e3e5; color: #383d41; }

  /* ── ACTION BUTTONS ── */
  .btn-action {
    display: inline-block;
    padding: 5px 12px;
    border-radius: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.15s ease;
    margin: 2px;
    font-family: 'DM Sans', sans-serif;
  }

  .btn-show   { background: var(--cream); color: var(--forest); border: 1px solid rgba(29,74,35,0.2); }
  .btn-show:hover { background: var(--lime); color: var(--forest); border-color: var(--lime); }

  .btn-delete { background: #fdecea; color: var(--error); border: 1px solid #f5c6c6; }
  .btn-delete:hover { background: #f5c6c6; }

  /* ── CREATE BUTTON ── */
  .create-new-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: var(--forest);
    color: white;
    padding: 10px 22px;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 4px 14px rgba(29,74,35,0.2);
  }

  .create-new-btn:hover {
    background: var(--lime);
    color: var(--forest);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(153,204,103,0.3);
  }

  .delete-form { display: inline; margin: 0; }

  /* ── DATATABLE OVERRIDES ── */
  .dataTables_wrapper { padding: 16px 20px; background: var(--cream); }

  .dataTables_filter input {
    border: 1.5px solid rgba(29,74,35,0.2);
    border-radius: 8px;
    padding: 7px 12px;
    margin-left: 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem;
    outline: none;
    transition: border-color 0.2s;
    background: white;
  }

  .dataTables_filter input:focus { border-color: var(--lime); }

  .dataTables_length select {
    border: 1.5px solid rgba(29,74,35,0.2);
    border-radius: 8px;
    padding: 5px 10px;
    margin: 0 6px;
    font-family: 'DM Sans', sans-serif;
    background: white;
  }

  .dataTables_paginate .paginate_button {
    padding: 6px 12px;
    margin: 0 2px;
    border-radius: 8px;
    border: 1px solid rgba(29,74,35,0.2) !important;
    background: white !important;
    color: var(--forest) !important;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
  }

  .dataTables_paginate .paginate_button:hover {
    background: var(--forest) !important;
    color: white !important;
    border-color: var(--forest) !important;
  }

  .dataTables_paginate .paginate_button.current {
    background: var(--forest) !important;
    color: white !important;
    border-color: var(--forest) !important;
  }

  .dataTables_paginate .paginate_button.disabled {
    color: #ccc !important;
    border-color: #eee !important;
  }

  .dataTables_info {
    color: #888;
    font-size: 0.82rem;
    font-family: 'DM Sans', sans-serif;
    padding-top: 8px;
  }

  td.dataTables_empty {
    text-align: center;
    color: #999;
    font-style: italic;
    padding: 40px !important;
    background: var(--cream) !important;
  }
</style>

<div class="content-wrapper">

  {% for message in app.flashes('success') %}
    <div class="flash-success">✓ {{ message }}</div>
  {% endfor %}
  {% for message in app.flashes('error') %}
    <div class="flash-error">⚠ {{ message }}</div>
  {% endfor %}

  <div class="page-header">
    <div>
      <h1>Stock Inventory</h1>
      <p>Manage product stock levels across EcoBrew.</p>
    </div>
    <a href="{{ path('app_stock_new') }}" class="create-new-btn">+ New Stock Entry</a>
  </div>

  <div class="table-card">
    <table id="stockTable" class="table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Product</th>
          <th>Image</th>
          <th>Quantity</th>
          <th>Last Updated</th>
          <th>Created By</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for stock in stocks %}
        <tr>
          <td><strong>#{{ stock.id }}</strong></td>
          <td>{{ stock.product ? stock.product.name : '—' }}</td>
          <td>
            {% if stock.product and stock.product.image %}
              <img src="{{ asset('uploads/images/' ~ stock.product.image) }}" alt="{{ stock.product.name }}">
            {% else %}
              <em style="color:#aaa;font-size:0.82rem;">No image</em>
            {% endif %}
          </td>
          <td><strong style="color:var(--forest);font-size:1rem;">{{ stock.quantity }}</strong></td>
          <td>{{ stock.lastUpdated ? stock.lastUpdated|date('Y-m-d H:i') : '—' }}</td>
          <td>
            {% if stock.createdBy %}
              <span class="badge {{ 'ROLE_ADMIN' in stock.createdBy.roles ? 'badge-admin' : 'badge-staff' }}">
                {{ 'ROLE_ADMIN' in stock.createdBy.roles ? 'Admin' : 'Staff' }} — {{ stock.createdBy.username }}
              </span>
            {% else %}
              <span class="badge badge-unknown">Unknown</span>
            {% endif %}
          </td>
          <td>
            <a href="{{ path('app_stock_show', {'id': stock.id}) }}" class="btn-action btn-show">View</a>

            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}
              <form method="post" action="{{ path('app_stock_delete', {'id': stock.id}) }}" class="delete-form"
                    onsubmit="return confirm('Delete stock record for {{ stock.product ? stock.product.name : 'Unknown' }} (Qty: {{ stock.quantity }})? This cannot be undone.');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ stock.id) }}">
                <button type="submit" class="btn-action btn-delete">Delete</button>
              </form>
            {% endif %}
          </td>
        </tr>
        {% else %}
        <tr>
          <td colspan="7" class="dataTables_empty">No stock records found.</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

</div>
{% endblock %}

{% block javascripts %}
<script>
$(document).ready(function() {
    $('#stockTable').DataTable({
        "order": [[0, "desc"]],
        "pageLength": 10,
        "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
        "language": {
            "search": "🔍 Search:",
            "lengthMenu": "Show _MENU_ entries",
            "info": "Showing _START_ to _END_ of _TOTAL_ stocks",
            "infoEmpty": "No stocks available",
            "infoFiltered": "(filtered from _MAX_ total stocks)",
            "zeroRecords": "No matching stock records found",
            "emptyTable": "No stock records available",
            "paginate": {
                "first": "First",
                "last": "Last",
                "next": "Next →",
                "previous": "← Prev"
            }
        },
        "columnDefs": [
            { "orderable": false, "targets": [2, 6] }
        ]
    });
});
</script>
{% endblock %}