 <style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600&display=swap');

  :root {
    --forest: #1D4A23;
    --midforest: #2A6132;
    --lime: #99CC67;
    --cream: #F0F7EC;
  }

  .form-container form {
    display: flex;
    flex-direction: column;
    gap: 0;
    font-family: 'DM Sans', sans-serif;
  }

  .form-container label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--forest);
    margin-bottom: 0.45rem;
    letter-spacing: 0.3px;
  }

  .form-container input,
  .form-container select,
  .form-container textarea {
    width: 100%;
    padding: 12px 16px;
    border: 1.5px solid rgba(29,74,35,0.18);
    border-radius: 10px;
    background: white;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    color: var(--forest);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
  }

  .form-container input:focus,
  .form-container select:focus,
  .form-container textarea:focus {
    border-color: var(--lime);
    box-shadow: 0 0 0 3px rgba(153,204,103,0.15);
  }

  .readonly-field {
    background: var(--cream);
    color: #999;
    cursor: not-allowed;
    border-color: rgba(29,74,35,0.1);
  }

  .form-row {
    margin-bottom: 1.25rem;
  }

  .form-row small {
    display: block;
    margin-top: 5px;
    font-size: 0.78rem;
    color: #999;
    font-family: 'DM Sans', sans-serif;
  }

  .form-error {
    color: #c0392b;
    font-size: 0.78rem;
    margin-top: 5px;
    font-family: 'DM Sans', sans-serif;
  }

  .form-actions {
    display: flex;
    gap: 10px;
    margin-top: 1.75rem;
    padding-top: 20px;
    border-top: 1px solid rgba(29,74,35,0.08);
  }

  .form-container button.btn {
    flex: 1;
    padding: 13px 20px;
    border-radius: 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    background: var(--forest);
    color: white;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 4px 16px rgba(29,74,35,0.2);
  }

  .form-container button.btn:hover {
    background: var(--lime);
    color: var(--forest);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(153,204,103,0.3);
  }

  .form-container .back-link {
    flex: 1;
    padding: 13px 20px;
    border-radius: 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    background: white;
    color: var(--forest);
    border: 1.5px solid rgba(29,74,35,0.15);
    text-decoration: none;
    text-align: center;
    transition: all 0.2s ease;
    display: inline-block;
  }

  .form-container .back-link:hover {
    border-color: var(--lime);
    background: var(--cream);
  }
</style>

{{ form_start(form) }}

  <div class="form-row">
    {{ form_label(form.product) }}
    {{ form_widget(form.product) }}
    {{ form_errors(form.product) }}
  </div>

  <div class="form-row">
    {{ form_label(form.quantity) }}
    {{ form_widget(form.quantity) }}
    {{ form_errors(form.quantity) }}
  </div>

  <div class="form-row">
    {{ form_label(form.lastUpdated) }}
    {{ form_widget(form.lastUpdated) }}
    {{ form_errors(form.lastUpdated) }}
    <small>This field is automatically set</small>
  </div>

  <div class="form-actions">
    <a href="{{ path('app_stock_index') }}" class="back-link">← Back to list</a>
    <button class="btn">{{ button_label|default('Save') }}</button>
  </div>

{{ form_end(form) }}
