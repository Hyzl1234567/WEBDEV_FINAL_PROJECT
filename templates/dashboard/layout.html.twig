<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Dashboard{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset('styles/dashboard.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.1/css/jquery.dataTables.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
</head>
<style>
body {
  margin: 0;
  font-family: 'DM Sans', sans-serif;
  background: #F5FAF2;
}

.dashboard-container {
  display: flex;
}

/* ── SIDEBAR (unchanged) ── */
.sidebar {
    position: fixed;
    left: 0;
    top: 0;
    width: 80px;
    height: 100vh;
    background-color: #1D4A23;
    color: white;
    transition: width 0.3s ease;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 1000;
}

.sidebar:hover {
    width: 220px;
}

 .sidebar-logo {
    position: absolute;
    top: 18px;
    left: 43%;
    transform: translateX(-50%);
    width: 100%;
    text-align: center;
    padding: 0 10px;
    overflow: hidden;
}

.sidebar-logo-text {
    font-family: 'Mollani-Regular', serif;
    font-size: 1.6rem;
    color: #99CC67;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
}

.sidebar:hover .sidebar-logo-text {
    opacity: 1;
    visibility: visible;
}

.nav-list {
    list-style: none;
    padding: 0;
    margin-top: 100px;
    width: 100%;
}

.nav-list li {
    width: 100%;
}

.nav-list a {
    display: flex;
    align-items: center;
    gap: 15px;
    text-decoration: none;
    color: white;
    padding: 12px 20px;
    font-size: 16px;
    transition: background 0.2s;
}

.nav-list i {
    font-size: 20px;
    min-width: 40px;
    text-align: center;
}

.nav-text {
    opacity: 0;
    visibility: hidden;
    white-space: nowrap;
    transition: opacity 0.3s ease, visibility 0.3s ease;
}

.sidebar:hover .nav-text {
    opacity: 1;
    visibility: visible;
}

.nav-list a:hover .nav-text {
    color: #1D4A23;
}

.nav-list a:hover {
    background-color: #F0F7EC;
    border-radius: 8px;\
}

.nav-list a:hover i {
    color: #1D4A23;
}

.nav-list a.active {
    background-color: #4e8744;
}

/* ── LAYOUT ── */
.main-content {
    flex: 1;
    margin-left: 80px;
    display: flex;
    flex-direction: column;
    transition: margin-left 0.3s ease;
    min-height: 100vh;
}

.sidebar:hover ~ .main-content {
    margin-left: 220px;
}

/* ── HEADER ── */
.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #F0F7EC;
    padding: 0 32px;
    height: 68px;
    border-bottom: 2px solid rgba(153,204,103,0.35);
    box-shadow: 0 2px 12px rgba(29,74,35,0.07);
    position: sticky;
    top: 0;
    z-index: 900;
}

/* ── LOGO (unchanged font/text) ── */
@font-face {
    font-family: 'Mollani-Regular';
    src: url('/fonts/Mollani-Regular.ttf') format('truetype');
}

.logo-text {
    font-family: 'Mollani-Regular', serif;
    font-size: 1.8rem;
    color: #1D4A23;
}

/* ── SYSTEM BANNER (unchanged animation) ── */
.system-banner {
    color: #2d572c;
    text-align: center;
    padding: 14px 0;
}

.system-banner h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: 1px;
    margin: 0;
    color: #2d572c;
    text-shadow: 1px 1px 3px rgba(8,124,61,0.3);
    animation: fadeInDown 1s ease;
}

@keyframes fadeInDown {
  from { opacity: 0; transform: translateY(-15px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* ── SEARCH / LOGOUT AREA ── */
.search-logout {
    display: flex;
    align-items: center;
    gap: 12px;
}

/* ── USER INFO ── */
.user-info {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px;
    background: #f0f7ec;
    border-radius: 50px;
    border: 1.5px solid rgba(29,74,35,0.15);
    cursor: pointer;
    transition: all 0.2s ease;
    text-decoration: none;
}

.user-info:hover {
    background: #e0f0d5;
    border-color: #99CC67;
    transform: translateY(-1px);
    box-shadow: 0 3px 10px rgba(29,74,35,0.1);
}

.user-info i {
    color: #2d4d22;
    font-size: 18px;
}

.user-details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

.user-name {
    font-weight: 600;
    color: #2d4d22;
    font-size: 13px;
    margin: 0;
}

.user-role {
    font-size: 11px;
    color: #666;
    margin: 0;
}

.user-role-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3px;
}

.role-admin {
    background: #fde8e8;
    color: #c0392b;
}

.role-staff {
    background: #e0f7f5;
    color: #1a8a7a;
}

/* ── LOGOUT BUTTON ── */
.logout {
    background: #1D4A23;
    color: white;
    border: none;
    padding: 8px 18px;
    border-radius: 50px;
    cursor: pointer;
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 600;
    transition: background 0.2s, transform 0.15s;
}

.logout:hover {
    background: #99CC67;
    color: #1D4A23;
    transform: translateY(-1px);
}

/* ── PAGE CONTENT ── */
.content {
    padding: 32px;
    background: #F5FAF2;
    flex: 1;
    min-height: calc(100vh - 68px);
}

/* ── SHARED BUTTONS ── */
.btn {
    padding: 6px 14px;
    border-radius: 8px;
    text-decoration: none;
    color: white;
    margin: 2px;
    font-family: 'DM Sans', sans-serif;
    font-size: 13px;
    font-weight: 600;
    border: none;
    cursor: pointer;
    transition: all 0.15s;
}

.btn-show   { background: #6F4E37; }
.btn-show:hover { background: #8b6347; }
.btn-edit   { background: #1D4A23; }
.btn-edit:hover { background: #2d6b34; }
.btn-add    { background: #99CC67; color: #1D4A23; }
.btn-add:hover  { background: #b6df8a; }
</style>

<body>
    <div class="dashboard-container">

        <!-- Sidebar (unchanged) -->
        <aside class="sidebar">
        <div class="sidebar-logo">
    <span class="sidebar-logo-text">🍵 EcoBrew</span>
</div>
            <ul class="nav-list">
                <li>
                    <a href="{{ path('app_dashboard') }}">
                        <i class="fas fa-home"></i>
                        <span class="nav-text">Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_product_index') }}">
                        <i class="fas fa-mug-hot"></i>
                        <span class="nav-text">Products</span>
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_stock_index') }}">
                        <i class="fas fa-boxes"></i>
                        <span class="nav-text">Stocks</span>
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_order_index') }}">
                        <i class="fas fa-shopping-cart"></i>
                        <span class="nav-text">Orders</span>
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_sales_index') }}">
                        <i class="fas fa-chart-line"></i>
                        <span class="nav-text">Sales</span>
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_category_index') }}">
                        <i class="fas fa-tags"></i>
                        <span class="nav-text">Categories</span>
                    </a>
                </li>
                <li>
                    <a href="{{ path('app_customer_index') }}">
                        <i class="fas fa-user"></i>
                        <span class="nav-text">Customers</span>
                    </a>
                </li>
            </ul>
        </aside>

        <!-- Main content -->
        <main class="main-content">

            <!-- Header -->
            <header class="header">
                <div class="logo">
                    <div class="logo-text">🍵EcoBrew</div>
                </div>

                <div class="system-banner">
                    <h2>Nature in Every Cup 🌿</h2>
                </div>

                <div class="search-logout">
                    <a href="{{ path('app_profile') }}" class="user-info" title="Go to My Profile">
                        <i class="fas fa-user-circle"></i>
                        <div class="user-details">
                            <p class="user-name">{{ app.user.username }}</p>
                            <p class="user-role">
                                {% if 'ROLE_ADMIN' in app.user.roles %}
                                    <span class="user-role-badge role-admin">Admin</span>
                                {% elseif 'ROLE_STAFF' in app.user.roles %}
                                    <span class="user-role-badge role-staff">Staff</span>
                                {% endif %}
                            </p>
                        </div>
                    </a>

                    <form action="{{ path('app_logout') }}" method="post" onsubmit="return confirm('⚠ Are you sure you want to log out?');">
                        <button type="submit" class="logout">Logout</button>
                    </form>
                </div>
            </header>

            <!-- Page content -->
            <section class="content">
                {% block body %}{% endblock %}
            </section>
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.js"></script>
    <script src="https://cdn.datatables.net/1.13.1/js/jquery.dataTables.min.js"></script>
    <script src="https://js.pusher.com/8.2.0/pusher.min.js"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>