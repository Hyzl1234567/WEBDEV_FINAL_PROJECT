{% extends 'dashboard/layout.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap');

:root {
    --cream: #F0F7EC;
    --forest: #1D4A23;
    --darkforest: #142E17;
    --midforest: #2A6132;
    --lime: #99CC67;
    --limelight: #B8DC8E;
    --limeshadow: #7AAD4C;
    --paper: #F5FAF2;
    --leaf: #C8E8AD;
}

*, *::before, *::after { box-sizing: border-box; }

.page-wrapper {
    min-height: 100vh;
    background: var(--paper);
    padding: 90px 2.5rem 4rem;
    font-family: 'DM Sans', sans-serif;
}

.page-inner {
    max-width: 1380px;
    margin: 0 auto;
}

/* ── PAGE HEADER ── */
.page-header {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 2rem;
    height: 140px;
    display: flex;
    align-items: flex-end;
}

.page-header-bg {
    position: absolute;
    inset: 0;
    background-image: url('https://images.unsplash.com/photo-1447933601403-0c6688de566e?w=1400&q=80&auto=format&fit=crop');
    background-size: cover;
    background-position: center 60%;
    transition: transform 8s ease;
}
.page-header:hover .page-header-bg { transform: scale(1.03); }

.page-header-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        105deg,
        rgba(29,74,35,0.93) 0%,
        rgba(42,97,50,0.75) 55%,
        rgba(29,74,35,0.60) 100%
    );
}

.page-header-content {
    position: relative;
    z-index: 2;
    padding: 0 2rem 1.5rem;
    width: 100%;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
}

.page-header-content h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.01em;
    margin-bottom: 3px;
    line-height: 1.1;
}

.page-header-eyebrow {
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--lime);
    opacity: 0.9;
}

.header-date {
    font-size: 0.75rem;
    color: rgba(255,255,255,0.45);
    font-weight: 300;
    letter-spacing: 0.05em;
}

/* ── STAT CARDS ── */
.dashboard-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 2rem;
}

.card {
    background: white;
    border-radius: 16px;
    padding: 1.4rem 1.5rem;
    border: 1px solid rgba(29,74,35,0.08);
    box-shadow: 0 2px 12px rgba(29,74,35,0.06);
    transition: transform 0.22s, box-shadow 0.22s;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    position: relative;
    overflow: hidden;
}

.card::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--forest), var(--lime));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s;
}

.card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 32px rgba(29,74,35,0.12);
}
.card:hover::after { transform: scaleX(1); }

.card-icon {
    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: var(--cream);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    margin-bottom: 0.25rem;
}

.card-label {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--midforest);
    opacity: 0.65;
}

.card-value {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--forest);
    line-height: 1;
}

.card-value.small {
    font-size: 1rem;
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    color: var(--midforest);
}

.card.manage-users {
    background: var(--forest);
    border-color: transparent;
    flex-direction: row;
    align-items: center;
    gap: 1.5rem;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
}
.card.manage-users::after { background: linear-gradient(90deg, var(--lime), var(--limelight)); }

.card.manage-users .card-icon {
    width: 52px;
    height: 52px;
    background: rgba(153,204,103,0.15);
    border: 1px solid rgba(153,204,103,0.3);
    font-size: 20px;
    flex-shrink: 0;
}

.card.manage-users .card-label { color: rgba(255,255,255,0.5); }
.card.manage-users .card-value.small { color: rgba(255,255,255,0.85); font-size: 0.88rem; }

.manage-users-text h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3rem;
    font-weight: 600;
    color: white;
    margin-bottom: 3px;
}

.manage-arrow {
    margin-left: auto;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(153,204,103,0.15);
    border: 1px solid rgba(153,204,103,0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--lime);
    font-size: 14px;
    transition: background 0.2s, transform 0.2s;
    flex-shrink: 0;
}
.card.manage-users:hover .manage-arrow {
    background: rgba(153,204,103,0.28);
    transform: translateX(3px);
}

/* ── ACTIVITY TABLE ── */
.recent-activities-section {
    background: white;
    border-radius: 20px;
    border: 1px solid rgba(29,74,35,0.08);
    box-shadow: 0 2px 16px rgba(29,74,35,0.06);
    overflow: hidden;
    margin-bottom: 2rem;
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.4rem 1.75rem;
    border-bottom: 1px solid rgba(29,74,35,0.07);
    background: var(--paper);
}

.section-header-left {
    display: flex;
    align-items: center;
    gap: 10px;
}

.section-header-icon {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--cream);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
}

.section-header h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--forest);
    letter-spacing: -0.01em;
}

.view-all-btn {
    background: var(--forest);
    color: white;
    padding: 8px 18px;
    border-radius: 100px;
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    box-shadow: 0 2px 10px rgba(29,74,35,0.18);
}
.view-all-btn:hover {
    background: var(--darkforest);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(29,74,35,0.26);
}

.activities-table {
    width: 100%;
    border-collapse: collapse;
}

.activities-table thead {
    background: var(--paper);
    border-bottom: 1px solid rgba(29,74,35,0.07);
}

.activities-table th {
    padding: 10px 14px;
    text-align: left;
    font-size: 0.64rem;
    font-weight: 600;
    color: var(--midforest);
    opacity: 0.6;
    letter-spacing: 0.14em;
    text-transform: uppercase;
}

.activities-table td {
    padding: 11px 14px;
    border-bottom: 1px solid rgba(29,74,35,0.05);
    font-size: 0.85rem;
    color: #333;
    vertical-align: middle;
}

.activities-table tbody tr:hover { background: var(--paper); }
.activities-table tbody tr:last-child td { border-bottom: none; }

.user-cell strong { font-size: 0.87rem; color: var(--forest); font-weight: 600; }
.user-cell small { font-size: 0.72rem; color: #aaa; }

.role-chip {
    font-size: 0.66rem;
    background: var(--cream);
    padding: 3px 9px;
    border-radius: 20px;
    color: var(--limeshadow);
    font-weight: 600;
    letter-spacing: 0.05em;
    border: 1px solid var(--limelight);
}

.activity-badge {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 0.66rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
}

.badge-create        { background: #d4edda; color: #155724; }
.badge-update        { background: #fff3cd; color: #856404; }
.badge-delete        { background: #f8d7da; color: #721c24; }
.badge-login         { background: #cfe2ff; color: #084298; }
.badge-logout        { background: #e2e3e5; color: #383d41; }
.badge-order_placed    { background: #e8f4fd; color: #0c5460; }
.badge-order_cancelled { background: #fdecea; color: #7f1d1d; }

.target-cell {
    font-size: 0.76rem;
    color: #856404;
    background: #fff9e6;
    padding: 3px 9px;
    border-radius: 6px;
    font-weight: 600;
    display: inline-block;
    max-width: 180px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    border: 1px solid #ffe8a0;
}

.description-cell {
    color: #888;
    font-size: 0.82rem;
    font-weight: 300;
    max-width: 200px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.timestamp-cell {
    color: #bbb;
    font-size: 0.78rem;
    font-weight: 300;
    white-space: nowrap;
}

.no-activities {
    text-align: center;
    padding: 4rem 2rem;
    color: #bbb;
}
.no-activities-icon { font-size: 3rem; margin-bottom: 0.75rem; }
.no-activities p { font-size: 0.88rem; font-weight: 300; }

@media (max-width: 1200px) { .dashboard-cards { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 900px) {
    .page-wrapper { padding: 80px 1.25rem 3rem; }
    .dashboard-cards { grid-template-columns: repeat(2, 1fr); }
    
}
@media (max-width: 600px) {
    .dashboard-cards { grid-template-columns: 1fr; }
    
}
</style>

<div class="page-wrapper">
<div class="page-inner">

    <!-- PAGE HEADER -->
    <div class="page-header">
        <div class="page-header-bg"></div>
        <div class="page-header-overlay"></div>
        <div class="page-header-content">
            <div>
                <div class="page-header-eyebrow">EcoBrew Admin</div>
                <h1>Dashboard Overview</h1>
            </div>
            <div class="header-date">{{ "now"|date("F d, Y") }}</div>
        </div>
    </div>

    <!-- STAT CARDS -->
    <div class="dashboard-cards">

        <a href="/admin/users/" class="card manage-users">
    <div class="card-icon">⚙️</div>
    <div class="card-label">Admin Panel</div>
    <div class="manage-users-text">
        <h3>Manage Users</h3>
    </div>
</a>

        <div class="card">
            <div class="card-icon">👥</div>
            <div class="card-label">Total Users</div>
            <div class="card-value">{{ totalUsers }}</div>
        </div>

        <div class="card">
            <div class="card-icon">🛡️</div>
            <div class="card-label">Total Admins</div>
            <div class="card-value">{{ totalAdmins }}</div>
        </div>

        <div class="card">
            <div class="card-icon">👔</div>
            <div class="card-label">Total Staff</div>
            <div class="card-value">{{ totalStaff }}</div>
        </div>

        <div class="card">
    <div class="card-icon">🛍️</div>
    <div class="card-label">Total Customers</div>
    <div class="card-value">{{ totalCustomers }}</div>
</div>
        <div class="card">
            <div class="card-icon">☕</div>
            <div class="card-label">Total Products</div>
            <div class="card-value">{{ totalProducts }}</div>
        </div>

        <div class="card">
            <div class="card-icon">🏷️</div>
            <div class="card-label">Categories</div>
            <div class="card-value">{{ totalCategories }}</div>
        </div>

        <div class="card">
            <div class="card-icon">📦</div>
            <div class="card-label">Stock Items</div>
            <div class="card-value">{{ totalStocks }}</div>
        </div>

    </div>

    <!-- RECENT ACTIVITIES -->
    <div class="recent-activities-section">
        <div class="section-header">
            <div class="section-header-left">
                <div class="section-header-icon">📋</div>
                <h2>Recent Activity</h2>
            </div>
            <a href="{{ path('app_activity_log_index') }}" class="view-all-btn">
                View All Logs →
            </a>
        </div>

        {% if recentActivities|length > 0 %}
        <table class="activities-table">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Role</th>
                    <th>Action</th>
                    <th>Target</th>
                    <th>Description</th>
                    <th>Time</th>
                </tr>
            </thead>
            <tbody>
            {% for log in recentActivities %}
                <tr>
                    <td class="user-cell">
                        {% if log.username %}
                            <strong>{{ log.username }}</strong>
                            {% if log.user %}<br><small>#{{ log.user.id }}</small>{% endif %}
                        {% elseif log.user %}
                            <strong>{{ log.user.username }}</strong>
                            <br><small>#{{ log.user.id }}</small>
                        {% else %}
                            <span style="color:#ccc;">System</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if log.role %}
                            <span class="role-chip">{{ log.role|replace({'ROLE_': ''}) }}</span>
                        {% else %}—{% endif %}
                    </td>
                    <td>
                        <span class="activity-badge badge-{{ log.action|lower }}">{{ log.action }}</span>
                    </td>
                    <td>
                        {% if log.description %}
                            <span class="target-cell" title="{{ log.description }}">
                                {{ log.description|slice(0, 35) }}{% if log.description|length > 35 %}…{% endif %}
                            </span>
                        {% else %}—{% endif %}
                    </td>
                    <td class="description-cell" title="{{ log.description }}">
                        {{ log.description|slice(0, 40) }}{% if log.description|length > 40 %}…{% endif %}
                    </td>
                    <td class="timestamp-cell">{{ log.createdAt|date('M d, H:i') }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        {% else %}
        <div class="no-activities">
            <div class="no-activities-icon">📭</div>
            <p>No recent activities to display</p>
        </div>
        {% endif %}
    </div>

</div>
</div>
{% endblock %}
