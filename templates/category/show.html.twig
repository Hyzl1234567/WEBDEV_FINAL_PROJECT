 {% extends 'dashboard/layout.html.twig' %}

{% block title %}Category Details{% endblock %}

{% block body %}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap');

  :root {
    --forest: #1D4A23;
    --midforest: #2A6132;
    --lime: #99CC67;
    --cream: #F0F7EC;
    --error: #c0392b;
    --success: #27ae60;
  }

  .show-wrap {
    max-width: 760px;
    margin: 48px auto;
    padding: 0 24px;
    font-family: 'DM Sans', sans-serif;
  }

  /* ── PAGE HEADER ── */
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 2px solid rgba(29,74,35,0.12);
  }

  .page-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 900;
    color: var(--forest);
    margin: 0 0 4px;
  }

  .page-header p {
    font-size: 0.88rem;
    color: var(--midforest);
    opacity: 0.7;
    margin: 0;
  }

  /* ── DETAIL CARD ── */
  .detail-card {
    background: var(--cream);
    border-radius: 16px;
    border: 1px solid rgba(29,74,35,0.08);
    box-shadow: 0 4px 24px rgba(29,74,35,0.07);
    overflow: hidden;
  }

  /* ── DETAIL TABLE ── */
  .detail-table {
    width: 100%;
    border-collapse: collapse;
  }

  .detail-table tr {
    border-bottom: 1px solid rgba(29,74,35,0.06);
  }

  .detail-table tr:last-child {
    border-bottom: none;
  }

  .detail-table th {
    width: 32%;
    padding: 16px 24px;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(255,255,255,0.85);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    text-align: left;
    background: var(--forest);
    vertical-align: top;
  }

  .detail-table td {
    padding: 16px 24px;
    font-size: 0.92rem;
    color: #2c3e50;
    background: var(--cream);
    vertical-align: top;
    line-height: 1.55;
  }

  .detail-table tbody tr:hover td {
    background: #e4f0da;
    transition: background 0.2s ease;
  }

  /* ── BADGES ── */
  .badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  .badge-admin   { background: #fde8e8; color: #c0392b; }
  .badge-staff   { background: #e0f7f5; color: #1a8a7a; }
  .badge-unknown { background: #e2e3e5; color: #383d41; }

  /* ── ACTION BAR ── */
  .action-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 20px 24px;
    background: white;
    border-top: 1px solid rgba(29,74,35,0.08);
    flex-wrap: wrap;
  }

  .action-bar-right {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  /* ── BUTTONS ── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 20px;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-back {
    background: var(--cream);
    color: var(--forest);
    border: 1.5px solid rgba(29,74,35,0.2);
  }
  .btn-back:hover {
    background: white;
    border-color: var(--forest);
  }

  .btn-edit {
    background: var(--forest);
    color: white;
    box-shadow: 0 4px 14px rgba(29,74,35,0.2);
  }
  .btn-edit:hover {
    background: var(--midforest);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(29,74,35,0.25);
  }

  .btn-delete {
    background: #fdecea;
    color: var(--error);
    border: 1.5px solid #f5c6c6;
  }
  .btn-delete:hover {
    background: #f5c6c6;
    transform: translateY(-1px);
  }

  .delete-form { display: inline; margin: 0; }

  /* ── LOCKED WARNING ── */
  .warning-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(192,57,43,0.05);
    border-top: 1px solid rgba(192,57,43,0.12);
    padding: 14px 24px;
    font-size: 0.85rem;
    color: #856404;
  }
</style>

<div class="show-wrap">

  <div class="page-header">
    <div>
      <h1>Category Details</h1>
      <p>Viewing full information for this category.</p>
    </div>
    <a href="{{ path('app_category_index') }}" class="btn btn-back">← Back to List</a>
  </div>

  <div class="detail-card">
    <table class="detail-table">
      <tbody>
        <tr>
          <th>ID</th>
          <td><strong>#{{ category.id }}</strong></td>
        </tr>
        <tr>
          <th>Name</th>
          <td>{{ category.name }}</td>
        </tr>
        <tr>
          <th>Description</th>
          <td>{{ category.description }}</td>
        </tr>
        <tr>
          <th>Created At</th>
          <td>{{ category.createdAt ? category.createdAt|date('F d, Y — H:i:s') : '—' }}</td>
        </tr>
        <tr>
          <th>Created By</th>
          <td>
            {% if category.createdBy %}
              <span class="badge {{ 'ROLE_ADMIN' in category.createdBy.roles ? 'badge-admin' : 'badge-staff' }}">
                {{ 'ROLE_ADMIN' in category.createdBy.roles ? 'Admin' : 'Staff' }} — {{ category.createdBy.username }}
              </span>
            {% else %}
              <span class="badge badge-unknown">Unknown</span>
            {% endif %}
          </td>
        </tr>
      </tbody>
    </table>

    {% set canEdit = is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}

    {% if canEdit %}
      <div class="action-bar">
        <span style="font-size:0.82rem; color:#aaa;">Category #{{ category.id }}</span>
        <div class="action-bar-right">
          <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn btn-edit">✏️ Edit</a>
          <form method="post" action="{{ path('app_category_delete', {'id': category.id}) }}" class="delete-form"
                onsubmit="return confirm('⚠️ Are you sure you want to delete this category?\n\nCategory: {{ category.name }}\n\nThis action cannot be undone!');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ category.id) }}">
            <button type="submit" class="btn btn-delete">🗑️ Delete</button>
          </form>
        </div>
      </div>
    {% else %}
      <div class="warning-bar">
        🔒 You need staff or admin privileges to edit or delete categories.
      </div>
    {% endif %}
  </div>

</div>
{% endblock %}
