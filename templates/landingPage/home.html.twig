{% extends 'landingPage/base.html.twig' %}

{% block title %}EcoBrew Café – Sip Sustainably{% endblock %}

{% block extra_styles %}
/* ===== HERO ===== */
.hero {
  min-height: calc(100vh - 70px);
  display: grid; grid-template-columns: 1fr 1fr;
  align-items: center;
  padding: 4rem 5rem;
  position: relative;
  overflow: hidden;
}
.hero::before {
  content: '';
  position: absolute; top: -100px; right: -100px;
  width: 600px; height: 600px;
  background: radial-gradient(circle, rgba(153,204,103,0.1) 0%, transparent 70%);
  border-radius: 50%;
}
.hero-tag {
  display: inline-block;
  background: rgba(153,204,103,0.15);
  color: var(--midforest);
  font-size: 0.75rem; font-weight: 600;
  letter-spacing: 2px; text-transform: uppercase;
  padding: 6px 14px; border-radius: 50px;
  margin-bottom: 1.5rem;
  border: 1px solid rgba(153,204,103,0.3);
}
.hero h1 {
  font-family: 'Playfair Display', serif;
  font-size: clamp(3rem, 5vw, 5rem);
  font-weight: 900;
  line-height: 1.05;
  color: var(--forest);
  margin-bottom: 1.5rem;
}
.hero h1 em { font-style: italic; color: var(--lime); }
.hero p {
  font-size: 1.05rem; line-height: 1.75;
  color: var(--midforest); opacity: 0.85;
  max-width: 440px;
  margin-bottom: 2.5rem;
}
.hero-cta { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
.hero-visual {
  display: flex; justify-content: center; align-items: center;
  position: relative;
}
.coffee-card {
  background: white;
  border-radius: 24px;
  padding: 2.5rem;
  box-shadow: 0 20px 60px rgba(29,74,35,0.1), 0 4px 16px rgba(29,74,35,0.06);
  max-width: 320px; width: 100%;
  position: relative;
}
.coffee-card::before {
  content: '';
  position: absolute; inset: -2px;
  border-radius: 26px;
  background: linear-gradient(135deg, var(--lime), var(--limelight), var(--leaf));
  z-index: -1;
  opacity: 0.4;
}
.coffee-emoji { font-size: 4rem; display: block; margin-bottom: 1rem; }
.coffee-card h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.4rem; font-weight: 700;
  color: var(--forest); margin-bottom: 0.5rem;
}
.coffee-card p { font-size: 0.9rem; color: var(--midforest); opacity: 0.8; line-height: 1.6; }
.coffee-tag {
  display: inline-block; margin-top: 1rem;
  background: var(--leaf); color: var(--forest);
  padding: 4px 12px; border-radius: 50px;
  font-size: 0.75rem; font-weight: 600;
}
.floating-badge {
  position: absolute;
  background: var(--lime); color: var(--forest);
  padding: 8px 14px; border-radius: 12px;
  font-size: 0.8rem; font-weight: 600;
  box-shadow: 0 8px 24px rgba(153,204,103,0.4);
  animation: float 3s ease-in-out infinite;
}
.badge-1 { top: 20px; right: -20px; }
.badge-2 { bottom: 30px; left: -30px; animation-delay: 1.5s; background: var(--forest); color: var(--lime); }
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

/* ===== FEATURES ===== */
.features { padding: 5rem; background: var(--paper); }
.features-header { text-align: center; margin-bottom: 3rem; }
.features-header h2 {
  font-family: 'Playfair Display', serif;
  font-size: 2.5rem; font-weight: 700; color: var(--forest);
}
.features-header p { color: var(--midforest); margin-top: 0.75rem; opacity: 0.8; }
.features-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
.feature-card {
  background: white; border-radius: 20px; padding: 2rem;
  border: 1px solid rgba(29,74,35,0.08);
  transition: transform 0.25s, box-shadow 0.25s;
}
.feature-card:hover { transform: translateY(-4px); box-shadow: 0 12px 40px rgba(29,74,35,0.1); }
.feature-icon {
  font-size: 2rem; margin-bottom: 1rem;
  width: 56px; height: 56px;
  background: rgba(153,204,103,0.12);
  border-radius: 14px;
  display: flex; align-items: center; justify-content: center;
}
.feature-card h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.15rem; font-weight: 700;
  margin-bottom: 0.5rem; color: var(--forest);
}
.feature-card p { font-size: 0.9rem; color: var(--midforest); opacity: 0.8; line-height: 1.65; }

/* ===== MENU ===== */
.menu-section { padding: 5rem; }
.menu-section h2 {
  font-family: 'Playfair Display', serif;
  font-size: 2.5rem; text-align: center; margin-bottom: 0.5rem; color: var(--forest);
}
.menu-subtitle { text-align: center; color: var(--midforest); opacity: 0.8; margin-bottom: 3rem; }
.menu-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
.menu-item {
  background: white; border-radius: 18px; overflow: hidden;
  border: 1px solid rgba(29,74,35,0.07);
  transition: transform 0.2s, box-shadow 0.2s; cursor: pointer;
}
.menu-item:hover { transform: translateY(-3px); box-shadow: 0 10px 30px rgba(29,74,35,0.1); }
.menu-img {
  height: 140px; display: flex; align-items: center; justify-content: center;
  font-size: 3.5rem;
  background: linear-gradient(135deg, var(--cream), var(--paper));
}
.menu-info { padding: 1.25rem; }
.menu-info h4 { font-family: 'Playfair Display', serif; font-weight: 700; margin-bottom: 0.3rem; color: var(--forest); }
.menu-info p { font-size: 0.82rem; color: var(--midforest); opacity: 0.75; }
.menu-price { display: flex; justify-content: space-between; align-items: center; margin-top: 0.75rem; }
.price { font-family: 'DM Mono', monospace; font-weight: 500; color: var(--limeshadow); font-size: 1rem; }
.eco-badge {
  font-size: 0.7rem; background: var(--leaf); color: var(--forest);
  padding: 2px 8px; border-radius: 50px; font-weight: 600;
}

/* ===== STATS ===== */
.stats {
  background: var(--forest); color: var(--cream);
  padding: 4rem 5rem;
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 2rem; text-align: center;
}
.stat-num {
  font-family: 'Playfair Display', serif;
  font-size: 3rem; font-weight: 900; color: var(--lime);
}
.stat-label { font-size: 0.9rem; opacity: 0.7; margin-top: 0.4rem; }

@media (max-width: 900px) {
  .hero { grid-template-columns: 1fr; padding: 3rem 2rem; }
  .hero-visual { display: none; }
  .features-grid, .menu-grid { grid-template-columns: 1fr 1fr; }
  .stats { grid-template-columns: 1fr 1fr; }
  .features, .menu-section { padding: 3rem 1.5rem; }
}
{% endblock %}

{% block body %}
<div style="padding-top: 70px;">

  {# HERO #}
  <section class="hero">
    <div class="hero-content">
      <span class="hero-tag">🌿 Sustainable Coffee</span>
      <h1>Nature<br><em>in every </em>Cup</h1>
      <p>EcoBrew Café brings you ethically sourced, eco-conscious coffee crafted to fuel your day — and protect the planet we love.</p>
      <div class="hero-cta">
        <a href="{{ path('about') }}" class="btn-primary">Our Story →</a>
        <button class="btn-outline" onclick="document.querySelector('.menu-section').scrollIntoView({behavior:'smooth'})">View Menu</button>
      </div>
    </div>
    <div class="hero-visual">
      <div class="coffee-card">
        <span class="coffee-emoji">☕</span>
