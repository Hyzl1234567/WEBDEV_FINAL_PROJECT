{% extends 'landingPage/base.html.twig' %}

{% block title %}Login – EcoBrew Café{% endblock %}

{% block extra_styles %}
.auth-wrap {
  min-height: calc(100vh - 70px);
  display: grid; grid-template-columns: 1fr 1fr;
  margin-top: 70px;
}
.auth-visual {
  background: linear-gradient(160deg, var(--forest) 0%, var(--darkforest) 60%, var(--midforest) 100%);
  display: flex; flex-direction: column;
  justify-content: center; align-items: center;
  padding: 4rem;
  position: relative; overflow: hidden;
}
.auth-visual::before {
  content: '';
  position: absolute; top: -150px; left: -150px;
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(153,204,103,0.15) 0%, transparent 70%);
  border-radius: 50%;
}
.auth-visual::after {
  content: '';
  position: absolute; bottom: -100px; right: -100px;
  width: 300px; height: 300px;
  background: radial-gradient(circle, rgba(153,204,103,0.08) 0%, transparent 70%);
  border-radius: 50%;
}
.auth-visual-title {
  font-family: 'Playfair Display', serif;
  font-size: 2.5rem; font-weight: 900;
  color: white; text-align: center; line-height: 1.2;
  margin-bottom: 1rem; position: relative; z-index: 1;
}
.auth-visual-sub {
  color: rgba(255,255,255,0.65); text-align: center;
  font-size: 1rem; line-height: 1.65;
  max-width: 300px; position: relative; z-index: 1;
}
.auth-big-emoji { font-size: 5rem; margin-bottom: 1.5rem; display: block; position: relative; z-index: 1; }

.auth-form-wrap {
  display: flex; flex-direction: column;
  justify-content: center; align-items: center;
  padding: 4rem;
  background: var(--paper);
}
.auth-form-inner { width: 100%; max-width: 400px; }
.auth-form-inner h2 {
  font-family: 'Playfair Display', serif;
  font-size: 2rem; font-weight: 800;
  color: var(--forest); margin-bottom: 0.4rem;
}
.auth-form-inner .sub { color: var(--midforest); opacity: 0.75; font-size: 0.9rem; margin-bottom: 2rem; }

.form-meta {
  display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;
}
.form-meta label { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; cursor: pointer; color: var(--midforest); }
.form-meta a { font-size: 0.85rem; color: var(--lime); font-weight: 500; cursor: pointer; text-decoration: none; }
.form-meta a:hover { text-decoration: underline; }

.auth-divider {
  text-align: center; color: var(--midforest); opacity: 0.5;
  font-size: 0.82rem; margin: 1.25rem 0;
  position: relative;
}
.auth-divider::before, .auth-divider::after {
  content: '';
  position: absolute; top: 50%; height: 1px;
  width: 38%; background: rgba(29,74,35,0.15);
}
.auth-divider::before { left: 0; }
.auth-divider::after { right: 0; }

.auth-switch { text-align: center; font-size: 0.88rem; color: var(--midforest); margin-top: 1.5rem; }
.auth-switch a { color: var(--forest); font-weight: 600; cursor: pointer; text-decoration: none; }
.auth-switch a:hover { color: var(--lime); text-decoration: underline; }

.alert-error {
  background: rgba(192,57,43,0.08); color: var(--error);
  border: 1px solid rgba(192,57,43,0.25);
  padding: 12px 16px; border-radius: 10px;
  font-size: 0.88rem; font-weight: 500; margin-bottom: 1.25rem;
}

@media (max-width: 900px) {
  .auth-wrap { grid-template-columns: 1fr; }
  .auth-visual { display: none; }
}
{% endblock %}

{% block body %}
<div class="auth-wrap">
  {# Left visual panel #}
  <div class="auth-visual">
    <span class="auth-big-emoji">☕</span>
    <div class="auth-visual-title">Welcome<br>Back to<br>EcoBrew</div>
    <div class="auth-visual-sub">Your sustainable coffee journey continues. Sign in to manage orders, loyalty points, and more.</div>
  </div>

  {# Login form #}
  <div class="auth-form-wrap">
    <div class="auth-form-inner">
      <h2>Sign In</h2>
      <p class="sub">Enter your credentials to access your account.</p>

    {% if error is defined and error %}
    <div class="alert-error">{{ error }}</div>
{% endif %}

      <form method="post" action="{{ path('login') }}">
        <div class="form-group">
          <label for="username">Username</label>
          <input type="username" id="username" name="username" placeholder="your username"
                 value="{{ last_username | default('')}}" autocomplete="username" required>
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password"
                 placeholder="••••••••" autocomplete="current-password" required>
        </div>
        <div class="form-meta">
          <label>
            <input type="checkbox" name="_remember_me"> Remember me
          </label>
          <a href="#">Forgot password?</a>
        </div>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit" class="btn-full">Sign In →</button>
      </form>

      <div class="auth-divider">or</div>

      <a href="{{ path('home') }}" class="btn-full"
         style="display:block;text-align:center;background:white;color:var(--forest);border:1.5px solid rgba(29,74,35,0.2);box-shadow:none;text-decoration:none;padding:14px;border-radius:10px;font-weight:600;font-size:1rem;">
        🌿 Continue as Guest
      </a>

      <div class="auth-switch">
        Don't have an account? <a href="{{ path('register') }}">Register here</a>
      </div>
    </div>
  </div>
</div>
{% endblock %}

