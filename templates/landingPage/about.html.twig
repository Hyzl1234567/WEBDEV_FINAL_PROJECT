      </div>
      <div class="story-block">
        <span class="sb-icon">🌱</span>
        <h4>12 Farm Partners</h4>
        <p>Direct relationships with smallholder growers</p>
      </div>
      <div class="story-block">
        <span class="sb-icon">🌍</span>
        <h4>Purpose in Every Cup</h4>
        <p>A step toward a healthier you and a greener planet</p>
      </div>
    </div>
  </div>
</section>

{# VALUES #}
<section class="values">
  <div class="section-header">
    <div class="section-eyebrow">What Drives Us</div>
    <h2>Our Values</h2>
  </div>
  <div class="values-grid">
    <div class="value-card">
      <span class="value-emoji">🌿</span>
