{% extends 'landingPage/base.html.twig' %}

{% block title %}About Us – EcoBrew Café{% endblock %}

{% block extra_styles %}
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&family=DM+Sans:wght@300;400;500;600&display=swap');

*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

.footer-brand-name { font-family: 'Mollani-Regular', serif; }

/* ===== HERO ===== */
.about-hero {
  position: relative;
  height: 520px;
  margin-top: 70px;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
}

.hero-bg {
  position: absolute;
  inset: 0;
  background-image: url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=1600&q=85&auto=format&fit=crop');
  background-size: cover;
  background-position: center 55%;
  transform: scale(1.04);
  transition: transform 10s ease;
}
.about-hero:hover .hero-bg { transform: scale(1); }

.hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(29,74,35,0.92) 0%,
    rgba(29,74,35,0.50) 45%,
    rgba(16,44,20,0.20) 100%
  );
}

.hero-content {
  position: relative;
  z-index: 2;
  padding: 0 5rem 3.5rem;
  width: 100%;
  text-align: center;
}

.hero-eyebrow {
  font-family: 'DM Sans', sans-serif;
  font-size: 0.68rem;
  font-weight: 500;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--lime, #99cc67);
  margin-bottom: 0.9rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
}
.hero-eyebrow::before,
.hero-eyebrow::after {
  content: '';
  display: inline-block;
  width: 30px;
  height: 1px;
  background: var(--lime, #99cc67);
}

.hero-content h1 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 4rem;
  font-weight: 300;
  color: #fff;
  line-height: 1.08;
  letter-spacing: -0.01em;
  margin-bottom: 0.85rem;
}
.hero-content h1 em {
  font-style: italic;
  color: var(--lime, #99cc67);
  font-weight: 400;
}

.hero-content p {
  font-size: 0.95rem;
  color: rgba(255,255,255,0.65);
  max-width: 540px;
  margin: 0 auto;
  line-height: 1.75;
  font-weight: 300;
}

/* Hero stats bar */
.hero-stats {
  position: absolute;
  bottom: 0;
  left: 0; right: 0;
  display: flex;
  justify-content: center;
  gap: 0;
  z-index: 3;
}
.hero-stat {
  flex: 1;
  max-width: 200px;
  padding: 1.1rem 1.5rem;
  background: rgba(255,255,255,0.07);
  backdrop-filter: blur(10px);
  border-top: 1px solid rgba(153,204,103,0.25);
  border-right: 1px solid rgba(153,204,103,0.12);
  text-align: center;
}
.hero-stat:last-child { border-right: none; }
.hero-stat .num {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.6rem;
  font-weight: 600;
  color: var(--lime, #99cc67);
  display: block;
  line-height: 1;
  margin-bottom: 3px;
}
.hero-stat .lbl {
  font-size: 0.65rem;
  color: rgba(255,255,255,0.5);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-weight: 400;
}

/* ===== STORY ===== */
.about-story {
  padding: 5rem;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4.5rem;
  align-items: center;
  background: var(--paper, #f7f5f0);
}

.story-text h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 2.4rem;
  font-weight: 600;
  color: var(--forest, #1d4a23);
  margin-bottom: 1.25rem;
  letter-spacing: -0.01em;
  line-height: 1.15;
}
.story-text h2 em {
  font-style: italic;
  color: var(--limeshadow, #5a8a2a);
}

.story-text p {
  font-family: 'DM Sans', sans-serif;
  color: var(--midforest, #3a6b40);
  opacity: 0.85;
  line-height: 1.8;
  margin-bottom: 1rem;
  font-size: 0.92rem;
  font-weight: 300;
}

.btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 1.25rem;
  padding: 0.75rem 1.75rem;
  background: var(--forest, #1d4a23);
  color: white;
  text-decoration: none;
  border-radius: 100px;
  font-family: 'DM Sans', sans-serif;
  font-size: 0.82rem;
  font-weight: 500;
  letter-spacing: 0.06em;
  transition: background 0.2s, transform 0.2s;
}
.btn-primary:hover {
  background: var(--darkforest, #122e16);
  transform: translateY(-2px);
}

/* Story right - photo + blocks */
.story-right { display: flex; flex-direction: column; gap: 1.25rem; }

.story-photo {
  position: relative;
  border-radius: 20px;
  overflow: hidden;
  height: 280px;
  box-shadow: 0 12px 40px rgba(29,74,35,0.18);
}
.story-photo img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 6s ease;
}
.story-photo:hover img { transform: scale(1.06); }

.story-photo-badge {
  position: absolute;
  top: 14px;
  right: 14px;
  background: var(--forest, #1d4a23);
  border: 1px solid rgba(153,204,103,0.35);
  border-radius: 100px;
  padding: 5px 14px;
  font-size: 0.68rem;
  color: var(--lime, #99cc67);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  font-weight: 500;
}

.story-blocks {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 0.85rem;
}

.story-block {
  border-radius: 14px;
  padding: 1.3rem 1.1rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}
.story-block:nth-child(1) {
  background: var(--forest, #1d4a23);
  color: white;
}
.story-block:nth-child(2) {
  background: var(--leaf, #c8e6a0);
  color: var(--forest, #1d4a23);
}
.story-block:nth-child(3) {
  background: var(--lime, #99cc67);
  color: var(--darkforest, #122e16);
}
.story-block .sb-icon { font-size: 1.6rem; }
.story-block h4 {
  font-family: 'Cormorant Garamond', serif;
  font-weight: 700;
  font-size: 0.95rem;
  line-height: 1.25;
}
.story-block p {
  font-size: 0.75rem;
  opacity: 0.75;
  line-height: 1.5;
  margin: 0;
}

/* ===== VALUES ===== */
.values {
  padding: 5rem;
  background: white;
  position: relative;
  overflow: hidden;
}
.values::before {
  content: '';
  position: absolute;
  top: -120px; right: -120px;
  width: 400px; height: 400px;
  background: radial-gradient(circle, rgba(153,204,103,0.08) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.section-header {
  text-align: center;
  margin-bottom: 3.5rem;
}
.section-eyebrow {
  font-size: 0.66rem;
  font-weight: 500;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--limeshadow, #5a8a2a);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  margin-bottom: 0.75rem;
}
.section-eyebrow::before,
.section-eyebrow::after {
  content: '';
  width: 24px;
  height: 1px;
  background: var(--limeshadow, #5a8a2a);
  opacity: 0.6;
}
.section-header h2 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 2.6rem;
  font-weight: 600;
  color: var(--forest, #1d4a23);
  letter-spacing: -0.01em;
}

.values-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  position: relative;
  z-index: 1;
}

.value-card {
  text-align: center;
  padding: 2.5rem 1.75rem;
  background: var(--paper, #f7f5f0);
  border-radius: 20px;
  border: 1px solid rgba(29,74,35,0.07);
  transition: transform 0.25s, box-shadow 0.25s, background 0.25s;
  position: relative;
  overflow: hidden;
}
.value-card::after {
  content: '';
  position: absolute;
  bottom: 0; left: 0; right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--forest, #1d4a23), var(--lime, #99cc67));
  transform: scaleX(0);
  transition: transform 0.3s;
  transform-origin: left;
}
.value-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 16px 48px rgba(29,74,35,0.10);
  background: white;
}
.value-card:hover::after { transform: scaleX(1); }

.value-emoji {
  font-size: 2.5rem;
  display: block;
  margin-bottom: 1rem;
}
.value-card h3 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--forest, #1d4a23);
  margin-bottom: 0.5rem;
}
.value-card p {
  font-family: 'DM Sans', sans-serif;
  font-size: 0.85rem;
  color: var(--midforest, #3a6b40);
  opacity: 0.8;
  line-height: 1.7;
  font-weight: 300;
}

/* ===== STORY PHOTO STRIP ===== */
.photo-strip {
  display: grid;
  grid-template-columns: 1fr 1.6fr 1fr;
  height: 320px;
  overflow: hidden;
}
.photo-strip-item {
  position: relative;
  overflow: hidden;
}
.photo-strip-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 6s ease;
  filter: brightness(0.88) saturate(1.1);
}
.photo-strip-item:hover img { transform: scale(1.08); }

.photo-strip-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(29,74,35,0.5) 0%, transparent 60%);
}
.photo-strip-label {
  position: absolute;
  bottom: 16px;
  left: 16px;
  font-size: 0.68rem;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.75);
  font-family: 'DM Sans', sans-serif;
}

  .team { padding: 5rem; }
.team h2 {
  font-family: 'Playfair Display', serif;
  font-size: 2.5rem; text-align: center;
  color: var(--forest); margin-bottom: 3rem;
}
.team-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
.team-card {
  text-align: center; padding: 2rem;
  border-radius: 20px; background: white;
  border: 1px solid rgba(29,74,35,0.08);
  transition: transform 0.2s;
}
.team-card:hover { transform: translateY(-4px); }
.team-avatar {
  width: 80px; height: 80px; border-radius: 50%;
  overflow: hidden;
  margin: 0 auto 1rem;
}
.team-avatar img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: center top;
}
.team-card h4 { font-family: 'Playfair Display', serif; font-weight: 700; color: var(--forest); margin-bottom: 0.25rem; }
.team-card .role { font-size: 0.82rem; color: var(--limeshadow); font-weight: 600; margin-bottom: 0.5rem; }
.team-card p { font-size: 0.85rem; color: var(--midforest); opacity: 0.75; line-height: 1.6; }

@media (max-width: 900px) {
  .about-hero, .about-story, .values, .team { padding: 3rem 1.5rem; }
  .about-hero h1 { font-size: 2.5rem; }
  .about-story { grid-template-columns: 1fr; }
  .values-grid, .team-grid { grid-template-columns: 1fr 1fr; }
}

/* ===== FOOTER ===== */
footer {
  background: var(--darkforest, #122e16);
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr;
  gap: 2rem;
  padding: 3.5rem 5rem;
}
.footer-brand h3 {
  font-family: 'Cormorant Garamond', serif;
  font-size: 1.5rem;
  font-weight: 600;
  color: #fff;
  margin-bottom: 0.5rem;
}
.footer-brand-name { color: var(--lime, #99cc67); }
.footer-brand p {
  font-size: 0.82rem;
  color: rgba(255,255,255,0.38);
  font-weight: 300;
  line-height: 1.7;
  max-width: 220px;
}
footer h4 {
  font-size: 0.65rem;
  font-weight: 500;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--lime, #99cc67);
  margin-bottom: 1rem;
}
footer ul { list-style: none; }
footer ul li { margin-bottom: 0.55rem; }
footer ul li a {
  font-size: 0.84rem;
  color: rgba(255,255,255,0.42);
  text-decoration: none;
  font-weight: 300;
  transition: color 0.2s;
}
footer ul li a:hover { color: #fff; }

.footer-bottom {
  background: rgba(10,20,12,0.8);
  text-align: center;
  padding: 1rem;
  font-size: 0.75rem;
  color: rgba(255,255,255,0.25);
  border-top: 1px solid rgba(255,255,255,0.05);
  font-family: 'DM Sans', sans-serif;
  font-weight: 300;
}

@media (max-width: 960px) {
  .about-hero { height: 420px; }
  .hero-content { padding: 0 2rem 5rem; }
  .hero-content h1 { font-size: 2.8rem; }
  .hero-stats { flex-wrap: wrap; }
  .about-story { grid-template-columns: 1fr; padding: 3rem 1.5rem; }
  .values { padding: 3rem 1.5rem; }
  .values-grid { grid-template-columns: 1fr 1fr; }
  .photo-strip { grid-template-columns: 1fr; height: 260px; }
  .photo-strip-item:not(:first-child) { display: none; }
  .team { padding: 3rem 1.5rem; }
  .team-grid { grid-template-columns: 1fr; }
  footer { grid-template-columns: 1fr 1fr; padding: 3rem 2rem; }
}
{% endblock %}

{% block body %}

{# HERO #}
<div class="about-hero">
  <div class="hero-bg"></div>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <div class="hero-eyebrow">EcoBrew Café · Est. 2025</div>
    <h1><em>Nature</em> in Every <em>Cup</em></h1>
    <p>EcoBrew believes nature is the main ingredient — serving fresh, eco-friendly drinks that are a healthier alternative in every sip.</p>
  </div>
