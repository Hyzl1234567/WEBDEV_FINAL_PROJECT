          </tbody>
        </table>
      </div>
    </div>

    {# ── CUSTOMERS ── #}
    <div class="admin-panel" id="admin-customers">
      <div class="admin-topbar">
        <div><h1>Customers</h1><p>View and manage your customer base</p></div>
        <div class="admin-actions">
          <button class="btn-sm btn-ghost" onclick="showAlert('Exported! 📊')">Export List</button>
        </div>
      </div>
      <div class="panel">
        <div class="mgmt-actions">
          <input type="text" class="search-input" placeholder="Search customers…">
        </div>
        <table class="items-table">
