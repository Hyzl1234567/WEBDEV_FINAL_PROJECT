              <div class="top-item-count">9 sold</div>
              <div class="top-item-bar" style="width:48%"></div>
            </div>
            <div class="top-item-rev">₱1,080</div>
          </div>
          <div class="top-item">
            <div class="top-item-icon">🥐</div>
