            <tr><td class="item-emoji-cell">🫖</td><td>Cold Brew</td><td>Cold Drinks</td><td>₱120</td><td><span class="status-badge status-done">Active</span></td><td><div class="action-btns"><button class="action-btn edit-btn" onclick="openModal()">Edit</button><button class="action-btn del-btn">Delete</button></div></td></tr>
