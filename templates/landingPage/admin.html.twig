              <div class="top-item-bar" style="width:90%"></div>
            </div>
            <div class="top-item-rev">₱2,610</div>
          </div>
          <div class="top-item">
            <div class="top-item-icon">🍵</div>
            <div class="top-item-info">
              <div class="top-item-name">Matcha Latte</div>
              <div class="top-item-count">12 sold</div>
              <div class="top-item-bar" style="width:65%"></div>
            </div>
            <div class="top-item-rev">₱1,860</div>
          </div>
          <div class="top-item">
            <div class="top-item-icon">🫖</div>
            <div class="top-item-info">
