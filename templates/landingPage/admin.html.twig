          <div class="bar-group"><div class="bar" style="height:55%;background:var(--leaf)"></div><span class="bar-val">₱5.1k</span><span class="bar-label">Mon</span></div>
          <div class="bar-group"><div class="bar" style="height:68%;background:var(--leaf)"></div><span class="bar-val">₱6.3k</span><span class="bar-label">Tue</span></div>
          <div class="bar-group"><div class="bar" style="height:72%;background:var(--limelight)"></div><span class="bar-val">₱6.7k</span><span class="bar-label">Wed</span></div>
          <div class="bar-group"><div class="bar" style="height:80%;background:var(--limelight)"></div><span class="bar-val">₱7.4k</span><span class="bar-label">Thu</span></div>
          <div class="bar-group"><div class="bar" style="height:90%;background:var(--lime)"></div><span class="bar-val">₱8.3k</span><span class="bar-label">Fri</span></div>
          <div class="bar-group"><div class="bar" style="height:100%;background:var(--limeshadow)"></div><span class="bar-val">₱9.2k</span><span class="bar-label">Sat</span></div>
