        </div>
        <div class="admin-actions">
          <button class="btn-sm btn-ghost" onclick="showAlert('Report exported! 📊')">Export Report</button>
          <button class="btn-sm btn-green" onclick="openModal()">+ New Order</button>
        </div>
      </div>

      <div class="kpi-grid">
        <div class="kpi-card">
          <div class="kpi-header"><span class="kpi-label">Today's Revenue</span><div class="kpi-icon" style="background:rgba(153,204,103,0.12);">💰</div></div>
          <div class="kpi-value">₱8,420</div>
          <div class="kpi-change kpi-up">↑ 12% vs yesterday</div>
        </div>
        <div class="kpi-card">
          <div class="kpi-header"><span class="kpi-label">Orders Today</span><div class="kpi-icon" style="background:rgba(29,74,35,0.08);">🛒</div></div>
          <div class="kpi-value">47</div>
          <div class="kpi-change kpi-up">↑ 5 more than avg</div>
        </div>
        <div class="kpi-card">
          <div class="kpi-header"><span class="kpi-label">Active Customers</span><div class="kpi-icon" style="background:rgba(184,220,142,0.2);">👥</div></div>
          <div class="kpi-value">1,284</div>
          <div class="kpi-change kpi-up">↑ 8% this month</div>
        </div>
        <div class="kpi-card">
          <div class="kpi-header"><span class="kpi-label">Eco Score</span><div class="kpi-icon" style="background:rgba(153,204,103,0.15);">🌿</div></div>
          <div class="kpi-value">98%</div>
          <div class="kpi-change kpi-up">↑ 1% this week</div>
        </div>
      </div>

      <div class="admin-grid">
        <div class="panel">
          <div class="panel-header">
            <h3>Recent Orders</h3>
            <button class="btn-sm btn-ghost" onclick="switchAdmin('orders', document.querySelector('[onclick*=orders]'))">View All</button>
          </div>
          <table class="orders-table">
            <thead><tr><th>Order #</th><th>Customer</th><th>Items</th><th>Total</th><th>Status</th></tr></thead>
            <tbody>
              <tr><td>#1089</td><td>Maria S.</td><td>Oat Latte × 2</td><td>₱290</td><td><span class="status-badge status-done">Done</span></td></tr>
              <tr><td>#1088</td><td>Juan D.</td><td>Cold Brew, Banana Loaf</td><td>₱230</td><td><span class="status-badge status-pending">Preparing</span></td></tr>
              <tr><td>#1087</td><td>Ana V.</td><td>Matcha Latte</td><td>₱155</td><td><span class="status-badge status-done">Done</span></td></tr>
              <tr><td>#1086</td><td>Carlo R.</td><td>Espresso × 3, Croissant</td><td>₱350</td><td><span class="status-badge status-new">New</span></td></tr>
              <tr><td>#1085</td><td>Rosa M.</td><td>Cacao Brew</td><td>₱130</td><td><span class="status-badge status-done">Done</span></td></tr>
            </tbody>
          </table>
        </div>
        <div class="panel">
          <div class="panel-header"><h3>Top Items Today</h3></div>
          <div class="top-item">
            <div class="top-item-icon">☕</div>
            <div class="top-item-info">
              <div class="top-item-name">Oat Latte</div>
