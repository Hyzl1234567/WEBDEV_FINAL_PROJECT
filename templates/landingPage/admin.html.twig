{% extends 'landingPage/base.html.twig' %}

{% block title %}Admin{% endblock %}

{% block body %}

{% block title %}Admin – EcoBrew Café{% endblock %}

{% block extra_styles %}
/* ===== ADMIN LAYOUT ===== */
.admin-wrap {
  display: grid; grid-template-columns: 260px 1fr;
  min-height: calc(100vh - 70px);
  margin-top: 70px;
}

/* ===== SIDEBAR ===== */
.admin-sidebar {
  background: var(--forest);
  padding: 2rem 0;
  position: sticky; top: 70px; height: calc(100vh - 70px);
  overflow-y: auto;
}
.sidebar-brand {
  padding: 1.5rem;
  border-bottom: 1px solid rgba(240,247,236,0.08);
  margin-bottom: 0.5rem;
}
.sidebar-brand-name {
  font-family: 'Playfair Display', serif;
  font-weight: 900; color: var(--lime); font-size: 1.1rem;
}
.sidebar-brand-sub {
  font-size: 0.78rem; color: rgba(240,247,236,0.4); margin-top: 3px;
}
.sidebar-label {
  font-size: 0.68rem; font-weight: 700;
  letter-spacing: 1.5px; text-transform: uppercase;
  color: rgba(240,247,236,0.35);
  padding: 1rem 1.5rem 0.5rem;
}
.sidebar-item {
  display: flex; align-items: center; gap: 10px;
  padding: 10px 1.5rem;
  color: rgba(240,247,236,0.7);
  font-size: 0.9rem; font-weight: 500;
  cursor: pointer;
  transition: all 0.15s;
  border-left: 3px solid transparent;
  text-decoration: none;
}
.sidebar-item:hover { color: var(--cream); background: rgba(240,247,236,0.06); }
.sidebar-item.active {
  color: var(--lime);
  background: rgba(153,204,103,0.1);
  border-left-color: var(--lime);
}
.sidebar-icon { font-size: 1rem; width: 20px; text-align: center; }

/* ===== ADMIN MAIN ===== */
.admin-main { background: var(--paper); padding: 2.5rem; }
.admin-panel { display: none; }
.admin-panel.active { display: block; }

.admin-topbar {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 2rem;
}
.admin-topbar h1 {
  font-family: 'Playfair Display', serif;
  font-size: 1.75rem; font-weight: 800; color: var(--forest);
}
.admin-topbar p { font-size: 0.88rem; color: var(--midforest); opacity: 0.7; margin-top: 2px; }
.admin-actions { display: flex; gap: 0.75rem; }

/* ===== KPI CARDS ===== */
.kpi-grid {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 1.25rem; margin-bottom: 2rem;
}
.kpi-card {
  background: white; border-radius: 16px; padding: 1.5rem;
  border: 1px solid rgba(29,74,35,0.07);
  transition: box-shadow 0.2s;
}
.kpi-card:hover { box-shadow: 0 8px 28px rgba(29,74,35,0.08); }
.kpi-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; }
.kpi-label {
  font-size: 0.78rem; font-weight: 600;
  color: var(--midforest); opacity: 0.7;
  letter-spacing: 0.5px; text-transform: uppercase;
}
.kpi-icon {
  width: 36px; height: 36px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center; font-size: 1.1rem;
}
.kpi-value {
  font-family: 'Playfair Display', serif;
  font-size: 2rem; font-weight: 900;
  color: var(--forest); margin-bottom: 0.25rem;
}
.kpi-change { font-size: 0.78rem; font-weight: 600; }
.kpi-up { color: var(--success); }
.kpi-down { color: var(--error); }

/* ===== PANELS ===== */
.admin-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem; }
.panel {
  background: white; border-radius: 16px; padding: 1.75rem;
  border: 1px solid rgba(29,74,35,0.07);
}
.panel-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 1.5rem;
}
.panel-header h3 {
  font-family: 'Playfair Display', serif;
  font-size: 1.15rem; font-weight: 700; color: var(--forest);
}

/* ===== BAR CHART ===== */
.bar-chart { display: flex; align-items: flex-end; gap: 8px; height: 160px; }
.bar-group { display: flex; flex-direction: column; align-items: center; gap: 6px; flex: 1; }
.bar {
  width: 100%; border-radius: 6px 6px 0 0;
  transition: opacity 0.2s; cursor: pointer; min-height: 4px;
}
.bar:hover { opacity: 0.8; }
.bar-label { font-size: 0.7rem; color: var(--midforest); opacity: 0.6; font-family: 'DM Mono', monospace; }
.bar-val { font-size: 0.68rem; color: var(--midforest); opacity: 0.5; }

/* ===== ORDERS TABLE ===== */
.orders-table { width: 100%; border-collapse: collapse; }
.orders-table th {
  text-align: left; font-size: 0.72rem; font-weight: 700;
  color: var(--midforest); opacity: 0.6; letter-spacing: 0.5px; text-transform: uppercase;
  padding: 0 0.75rem 0.75rem;
  border-bottom: 1px solid rgba(29,74,35,0.1);
}
.orders-table td {
  padding: 0.75rem;
  font-size: 0.88rem; color: var(--forest);
  border-bottom: 1px solid rgba(29,74,35,0.05);
  vertical-align: middle;
}
.orders-table tr:last-child td { border-bottom: none; }
.orders-table tr:hover td { background: rgba(153,204,103,0.04); }

.status-badge {
  display: inline-block; padding: 3px 10px; border-radius: 50px;
  font-size: 0.72rem; font-weight: 600;
}
.status-done { background: rgba(39,174,96,0.1); color: var(--success); }
.status-pending { background: rgba(212,134,58,0.1); color: var(--amber); }
.status-new { background: rgba(153,204,103,0.12); color: var(--limeshadow); }

/* ===== TOP ITEMS ===== */
.top-item {
  display: flex; align-items: center; gap: 0.75rem;
  padding: 0.65rem 0;
  border-bottom: 1px solid rgba(29,74,35,0.06);
}
.top-item:last-child { border-bottom: none; }
.top-item-icon {
  width: 36px; height: 36px; border-radius: 10px;
  background: var(--cream);
  display: flex; align-items: center; justify-content: center; font-size: 1.2rem;
  flex-shrink: 0;
}
.top-item-info { flex: 1; }
.top-item-name { font-size: 0.88rem; font-weight: 600; color: var(--forest); margin-bottom: 2px; }
.top-item-count { font-size: 0.78rem; color: var(--midforest); opacity: 0.7; }
.top-item-bar { height: 4px; border-radius: 2px; background: var(--leaf); margin-top: 4px; }
.top-item-rev { font-size: 0.85rem; font-weight: 700; color: var(--limeshadow); font-family: 'DM Mono', monospace; }

/* ===== MANAGEMENT TABLES ===== */
.mgmt-actions { display: flex; gap: 1rem; margin-bottom: 1.5rem; align-items: center; }
.search-input {
  flex: 1; padding: 10px 16px;
  border: 1.5px solid rgba(29,74,35,0.15);
  border-radius: 10px; outline: none;
  font-family: 'DM Sans', sans-serif; font-size: 0.9rem;
  background: white; color: var(--forest);
  transition: border-color 0.2s;
}
.search-input:focus { border-color: var(--lime); }

.items-table { width: 100%; border-collapse: collapse; }
.items-table th {
  text-align: left; font-size: 0.72rem; font-weight: 700;
  color: var(--midforest); opacity: 0.6; letter-spacing: 0.5px; text-transform: uppercase;
  padding: 0.75rem 1rem;
  background: var(--cream); border-bottom: 1px solid rgba(29,74,35,0.1);
}
.items-table th:first-child { border-radius: 8px 0 0 8px; }
.items-table th:last-child { border-radius: 0 8px 8px 0; }
.items-table td {
  padding: 0.85rem 1rem;
  font-size: 0.88rem; color: var(--forest);
  border-bottom: 1px solid rgba(29,74,35,0.06);
  vertical-align: middle;
}
.items-table tr:hover td { background: rgba(153,204,103,0.03); }
.item-emoji-cell { font-size: 1.5rem; }
.action-btns { display: flex; gap: 6px; }
.action-btn {
  padding: 5px 12px; border-radius: 7px;
  font-size: 0.78rem; font-weight: 600; cursor: pointer;
  border: none; transition: all 0.15s;
}
.edit-btn { background: rgba(153,204,103,0.12); color: var(--midforest); }
.edit-btn:hover { background: var(--lime); color: var(--forest); }
.del-btn { background: rgba(192,57,43,0.1); color: var(--error); }
.del-btn:hover { background: var(--error); color: white; }

@media (max-width: 900px) {
  .admin-wrap { grid-template-columns: 1fr; }
  .admin-sidebar { display: none; }
  .kpi-grid { grid-template-columns: 1fr 1fr; }
}
{% endblock %}

{% block body %}
<div class="admin-wrap">

  {# SIDEBAR #}
  <aside class="admin-sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-brand-name">☕ EcoBrew Admin</div>
      <div class="sidebar-brand-sub">Management Panel</div>
    </div>

    <div class="sidebar-label">Overview</div>
    <div class="sidebar-item active" onclick="switchAdmin('dashboard', this)">
      <span class="sidebar-icon">📊</span> Dashboard
    </div>

    <div class="sidebar-label">Manage</div>
    <div class="sidebar-item" onclick="switchAdmin('orders', this)">
      <span class="sidebar-icon">🛒</span> Orders
    </div>
    <div class="sidebar-item" onclick="switchAdmin('menu', this)">
      <span class="sidebar-icon">☕</span> Menu Items
    </div>
    <div class="sidebar-item" onclick="switchAdmin('customers', this)">
      <span class="sidebar-icon">👥</span> Customers
    </div>
    <div class="sidebar-item" onclick="switchAdmin('inventory', this)">
      <span class="sidebar-icon">📦</span> Inventory
    </div>

    <div class="sidebar-label">Reports</div>
    <div class="sidebar-item" onclick="switchAdmin('analytics', this)">
      <span class="sidebar-icon">📈</span> Analytics
    </div>
    <div class="sidebar-item" onclick="switchAdmin('ecoimpact', this)">
      <span class="sidebar-icon">🌿</span> Eco Impact
    </div>

    <div class="sidebar-label">System</div>
    <div class="sidebar-item" onclick="switchAdmin('settings', this)">
      <span class="sidebar-icon">⚙️</span> Settings
    </div>
    <a class="sidebar-item" href="{{ path('app_logout') }}">
      <span class="sidebar-icon">🚪</span> Sign Out
    </a>
