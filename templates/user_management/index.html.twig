 {% extends 'base.html.twig' %}

{% block title %}User Management{% endblock %}

{% block body %}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap');

  :root {
    --forest: #1D4A23;
    --midforest: #2A6132;
    --lime: #99CC67;
    --cream: #F0F7EC;
    --paper: #F0F7EC;
    --error: #c0392b;
    --success: #27ae60;
  }

  .um-wrap {
    max-width: 1300px;
    margin: 40px auto;
    padding: 0 24px;
    font-family: 'DM Sans', sans-serif;
  }

  .um-page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 2px solid rgba(29,74,35,0.12);
  }

  .um-page-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 900;
    color: var(--forest);
    margin: 0 0 4px;
  }

  .um-page-header p {
    font-size: 0.88rem;
    color: var(--midforest);
    opacity: 0.7;
    margin: 0;
  }

  .um-header-actions { display: flex; gap: 10px; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 20px;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.88rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s ease;
    letter-spacing: 0.2px;
  }

  .btn-primary   { background: var(--forest); color: white; }
  .btn-primary:hover { background: var(--lime); color: var(--forest); transform: translateY(-1px); }

  .btn-secondary { background: white; color: var(--forest); border: 1.5px solid rgba(29,74,35,0.2); }
  .btn-secondary:hover { border-color: var(--lime); background: var(--cream); }

  .btn-sm {
    padding: 5px 12px;
    border-radius: 8px;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .btn-edit   { background: var(--forest); color: white; }
  .btn-edit:hover { background: var(--midforest); }

  .btn-warn   { background: #fff3cd; color: #856404; border: 1px solid #ffe08a; }
  .btn-warn:hover { background: #ffe08a; }

  .btn-danger { background: #fdecea; color: var(--error); border: 1px solid #f5c6c6; }
  .btn-danger:hover { background: #f5c6c6; }

  .btn-muted  { background: #f0f0f0; color: #555; }
  .btn-muted:hover { background: #e0e0e0; }

  .flash-success {
    background: rgba(39,174,96,0.1);
    border-left: 4px solid var(--success);
    color: var(--success);
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    margin-bottom: 20px;
  }

  .table-card {
    background: var(--cream);
    border-radius: 16px;
    border: 1px solid rgba(29,74,35,0.08);
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(29,74,35,0.07);
  }

  table { width: 100%; border-collapse: collapse; }

  thead { background: var(--forest); }

  thead th {
    padding: 14px 18px;
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(255,255,255,0.85);
    text-transform: uppercase;
    letter-spacing: 0.8px;
    text-align: left;
  }

  tbody td {
    padding: 14px 18px;
    font-size: 0.88rem;
    color: #2c3e50;
    border-bottom: 1px solid rgba(29,74,35,0.06);
    vertical-align: middle;
  }

  tbody tr:last-child td { border-bottom: none; }
  tbody tr:hover { background: var(--cream); }

  .status-badge {
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.4px;
  }

  .status-active   { background: #d4edda; color: #155724; }
  .status-disabled { background: #f8d7da; color: #721c24; }
  .status-archived { background: #e2e3e5; color: #383d41; }

  .role-badge {
    padding: 3px 9px;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    display: inline-block;
    margin: 2px 2px 2px 0;
  }

  .role-admin    { background: #fde8e8; color: #c0392b; }
  .role-staff    { background: #e0f7f5; color: #1a8a7a; }
  .role-customer { background: #e8f4fd; color: #1a6fa8; }  /* ← new */
  .role-user     { background: var(--cream); color: var(--forest); }

  .empty-state { text-align: center; padding: 60px 20px; color: #888; }
  .empty-state p { font-size: 0.95rem; margin: 0; }

  .actions-cell { display: flex; gap: 4px; flex-wrap: wrap; }
  .delete-form  { display: inline; }
</style>

<div class="um-wrap">

  {% for message in app.flashes('success') %}
    <div class="flash-success">✓ {{ message }}</div>
  {% endfor %}

  <div class="um-page-header">
    <div>
      <h1>User Management</h1>
      <p>Manage accounts, roles, and access across EcoBrew.</p>
    </div>
    <div class="um-header-actions">
      <a href="{{ path('app_user_management_new') }}" class="btn btn-primary">+ New User</a>
      <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">← Dashboard</a>
    </div>
  </div>

  <div class="table-card">
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Username</th>
          <th>Email</th>
          <th>Full Name</th>
          <th>Roles</th>
          <th>Status</th>
          <th>Created At</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {% for user in users %}
        <tr>
          <td><strong>#{{ user.id }}</strong></td>
          <td><strong>{{ user.username }}</strong></td>
          <td>{{ user.email ?? '—' }}</td>
          <td>{{ user.fullName ?? '—' }}</td>
          <td>
            {% for role in user.roles %}
              {% if role == 'ROLE_ADMIN' %}
                <span class="role-badge role-admin">Admin</span>
              {% elseif role == 'ROLE_STAFF' %}
                <span class="role-badge role-staff">Staff</span>
              {% elseif role == 'ROLE_CUSTOMER' %}
                <span class="role-badge role-customer">Customer</span>
              {% elseif role == 'ROLE_USER' %}
                <span class="role-badge role-user">User</span>
              {% endif %}
            {% endfor %}
          </td>
          <td>
            <span class="status-badge status-{{ user.status }}">
              {{ user.status|capitalize }}
            </span>
          </td>
          <td>{{ user.createdAt ? user.createdAt|date('Y-m-d H:i') : '—' }}</td>
          <td>
            <div class="actions-cell">
              <a href="{{ path('app_user_management_edit', {id: user.id}) }}" class="btn btn-sm btn-edit">Edit</a>
              <a href="{{ path('app_user_management_reset_password', {id: user.id}) }}" class="btn btn-sm btn-warn">Reset PW</a>
              {% if user.status == 'active' %}
                <a href="{{ path('app_user_management_toggle_status', {id: user.id}) }}" class="btn btn-sm btn-warn">Disable</a>
              {% else %}
                <a href="{{ path('app_user_management_toggle_status', {id: user.id}) }}" class="btn btn-sm btn-edit">Enable</a>
              {% endif %}
              <a href="{{ path('app_user_management_archive', {id: user.id}) }}" class="btn btn-sm btn-muted">Archive</a>
              <form method="post" action="{{ path('app_user_management_delete', {id: user.id}) }}" class="delete-form"
                    onsubmit="return confirm('Delete {{ user.username }}? This cannot be undone.');">
                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
              </form>
            </div>
          </td>
        </tr>
        {% else %}
        <tr>
          <td colspan="8">
            <div class="empty-state">
              <p>No users found. <a href="{{ path('app_user_management_new') }}" style="color:var(--forest);font-weight:600;">Create the first one →</a></p>
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

</div>
{% endblock %}
