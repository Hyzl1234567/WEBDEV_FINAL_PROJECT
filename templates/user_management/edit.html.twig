{% extends 'base.html.twig' %}

{% block title %}Edit User{% endblock %}

{% block body %}
<style>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&display=swap');

  :root {
    --forest: #1D4A23;
    --midforest: #2A6132;
    --lime: #99CC67;
    --cream: #F0F7EC;
    --paper: #F0F7EC;
  }

  .cu-wrap {
    min-height: calc(100vh - 70px);
    background: var(--paper);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 20px;
    font-family: 'DM Sans', sans-serif;
  }

  .cu-card {
    background: var(--cream);
    border-radius: 20px;
    border: 1px solid rgba(29,74,35,0.1);
    box-shadow: 0 8px 40px rgba(29,74,35,0.09);
    width: 100%;
    max-width: 560px;
    overflow: hidden;
  }

  .cu-card-header {
    background: linear-gradient(135deg, var(--forest), var(--midforest));
    padding: 28px 32px;
  }

  .cu-card-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    font-weight: 900;
    color: white;
    margin: 0 0 4px;
  }

  .cu-card-header p {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.65);
    margin: 0;
    font-weight: 300;
  }

  .cu-card-header strong { color: var(--lime); }

  .cu-card-body { padding: 32px; }

  .form-group { margin-bottom: 1.25rem; }

  .form-group label {
    display: block;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--forest);
    margin-bottom: 0.45rem;
    letter-spacing: 0.3px;
  }

  .form-group input,
  .form-group select {
    width: 100%;
    padding: 12px 16px;
    border: 1.5px solid rgba(29,74,35,0.18);
    border-radius: 10px;
    background: white;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    color: var(--forest);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
    box-sizing: border-box;
  }

  .form-group input:focus,
  .form-group select:focus {
    border-color: var(--lime);
    box-shadow: 0 0 0 3px rgba(153,204,103,0.15);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-divider {
    border: none;
    border-top: 1px solid rgba(29,74,35,0.08);
    margin: 1.5rem 0;
  }

  .select-hint {
    display: flex;
    gap: 6px;
    margin-top: 8px;
    flex-wrap: wrap;
  }

  .hint-pill {
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }

  .rp-admin    { background: #fde8e8; color: #c0392b; }
  .rp-staff    { background: #e0f7f5; color: #1a8a7a; }
  .rp-customer { background: #e8f4fd; color: #1a6fa8; }  /* ← new */
  .rp-user     { background: var(--cream); color: var(--forest); border: 1px solid rgba(29,74,35,0.15); }

  .sp-active   { background: #d4edda; color: #155724; }
  .sp-disabled { background: #f8d7da; color: #721c24; }
  .sp-archived { background: #e2e3e5; color: #383d41; }

  .btn-group {
    display: flex;
    gap: 10px;
    margin-top: 1.75rem;
  }

  .btn {
    flex: 1;
    padding: 13px 20px;
    border-radius: 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    border: none;
    cursor: pointer;
    text-decoration: none;
    text-align: center;
    transition: all 0.2s ease;
    display: inline-block;
  }

  .btn-primary {
    background: var(--forest);
    color: white;
    box-shadow: 0 4px 16px rgba(29,74,35,0.2);
  }

  .btn-primary:hover {
    background: var(--lime);
    color: var(--forest);
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(153,204,103,0.3);
  }

  .btn-secondary {
    background: white;
    color: var(--forest);
    border: 1.5px solid rgba(29,74,35,0.15);
  }

  .btn-secondary:hover {
    border-color: var(--lime);
    background: #e8f5e0;
  }
</style>

<div class="cu-wrap">
  <div class="cu-card">

    <div class="cu-card-header">
      <h1>Edit User</h1>
      <p>Editing account for <strong>{{ user.username }}</strong></p>
    </div>

    <div class="cu-card-body">
      <form method="post">

        <div class="form-row">
          <div class="form-group">
            <label for="username">Username *</label>
            <input type="text" name="username" id="username" value="{{ user.username }}" required>
          </div>
          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" name="email" id="email" value="{{ user.email }}">
          </div>
        </div>

        <div class="form-group">
          <label for="full_name">Full Name</label>
          <input type="text" name="full_name" id="full_name" value="{{ user.fullName }}">
        </div>

        <hr class="form-divider">

        <div class="form-row">
          <div class="form-group">
            <label for="role">Role *</label>
            <select name="role" id="role" required>
              <option value="ROLE_CUSTOMER"
                {% if 'ROLE_CUSTOMER' in user.roles %}selected{% endif %}>
                Customer
              </option>
              <option value="ROLE_USER"
                {% if 'ROLE_USER' in user.roles and 'ROLE_ADMIN' not in user.roles and 'ROLE_STAFF' not in user.roles and 'ROLE_CUSTOMER' not in user.roles %}selected{% endif %}>
                User
              </option>
              <option value="ROLE_STAFF"
                {% if 'ROLE_STAFF' in user.roles %}selected{% endif %}>
                Staff
              </option>
              <option value="ROLE_ADMIN"
                {% if 'ROLE_ADMIN' in user.roles %}selected{% endif %}>
                Admin
              </option>
            </select>
            <div class="select-hint">
              <span class="hint-pill rp-admin">Admin</span>
              <span class="hint-pill rp-staff">Staff</span>
              <span class="hint-pill rp-customer">Customer</span>
              <span class="hint-pill rp-user">User</span>
            </div>
          </div>

          <div class="form-group">
            <label for="status">Status *</label>
            <select name="status" id="status" required>
              <option value="active"   {% if user.status == 'active'   %}selected{% endif %}>Active</option>
              <option value="disabled" {% if user.status == 'disabled' %}selected{% endif %}>Disabled</option>
              <option value="archived" {% if user.status == 'archived' %}selected{% endif %}>Archived</option>
            </select>
            <div class="select-hint">
              <span class="hint-pill sp-active">Active</span>
              <span class="hint-pill sp-disabled">Disabled</span>
              <span class="hint-pill sp-archived">Archived</span>
            </div>
          </div>
        </div>

        <div class="btn-group">
          <button type="submit" class="btn btn-primary">Save Changes →</button>
          <a href="{{ path('app_user_management_index') }}" class="btn btn-secondary">Cancel</a>
        </div>

      </form>
    </div>

  </div>
</div>
{% endblock %}
