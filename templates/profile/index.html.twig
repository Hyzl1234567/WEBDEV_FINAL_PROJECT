{% extends 'dashboard/layout.html.twig' %}

{% block title %}My Profile{% endblock %}

{% block body %}
<style>
@import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400&family=DM+Sans:wght@300;400;500;600&display=swap');

:root {
    --cream: #F0F7EC;
    --forest: #1D4A23;
    --darkforest: #142E17;
    --midforest: #2A6132;
    --lime: #99CC67;
    --limelight: #B8DC8E;
    --limeshadow: #7AAD4C;
    --paper: #F5FAF2;
    --leaf: #C8E8AD;
    --gold: #C9A84C;
    --amber: #D4863A;
    --error: #c0392b;
    --success: #27ae60;
}

*, *::before, *::after { box-sizing: border-box; }

.profile-page {
    min-height: 100vh;
    background: var(--paper);
    font-family: 'DM Sans', sans-serif;
    padding: 3rem 1.5rem 4rem;
}

.profile-wrapper {
    max-width: 680px;
    margin: 0 auto;
}

/* ── HERO BANNER ── */
.profile-banner {
    position: relative;
    border-radius: 24px 24px 0 0;
    overflow: hidden;
    height: 180px;
}

.profile-banner-img {
    position: absolute;
    inset: 0;
    background-image: url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?w=1200&q=85&auto=format&fit=crop');
    background-size: cover;
    background-position: center 45%;
    transition: transform 8s ease;
}
.profile-banner:hover .profile-banner-img { transform: scale(1.04); }

.profile-banner-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        135deg,
        rgba(29,74,35,0.88) 0%,
        rgba(42,97,50,0.72) 60%,
        rgba(20,46,23,0.80) 100%
    );
}

.profile-banner-content {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    align-items: flex-end;
    padding: 1.5rem 2rem;
    gap: 1.25rem;
}

.profile-avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: rgba(153,204,103,0.18);
    border: 2px solid rgba(153,204,103,0.5);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    flex-shrink: 0;
    box-shadow: 0 4px 20px rgba(0,0,0,0.2);
}

.profile-banner-text {}
.profile-banner-text h1 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.75rem;
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.01em;
    margin-bottom: 2px;
    line-height: 1.1;
}
.profile-banner-text p {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lime);
    opacity: 0.9;
}

/* ── CARD ── */
.profile-card {
    background: white;
    border-radius: 0 0 20px 20px;
    border: 1px solid rgba(29,74,35,0.09);
    border-top: none;
    overflow: hidden;
    box-shadow: 0 8px 40px rgba(29,74,35,0.08);
}

/* ── ALERT ── */
.alert {
    margin: 1.5rem 2rem 0;
    padding: 12px 16px;
    border-radius: 12px;
    font-size: 0.84rem;
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 400;
}
.alert-success {
    background: rgba(39,174,96,0.07);
    color: var(--success);
    border: 1px solid rgba(39,174,96,0.22);
}
.alert-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--success);
    flex-shrink: 0;
}

/* ── BODY ── */
.profile-body { padding: 0 2rem 1.5rem; }

.section-label {
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--limeshadow);
    opacity: 0.75;
    padding: 1.6rem 0 0.8rem;
    display: flex;
    align-items: center;
    gap: 10px;
}
.section-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(29,74,35,0.08);
}

.info-row {
    display: flex;
    align-items: center;
    padding: 0.85rem 0;
    border-bottom: 1px solid rgba(29,74,35,0.055);
    gap: 1.25rem;
}
.info-row:last-child { border-bottom: none; }

.info-icon {
    width: 34px;
    height: 34px;
    border-radius: 9px;
    background: var(--cream);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    flex-shrink: 0;
}

.info-label {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--midforest);
    opacity: 0.65;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    width: 110px;
    flex-shrink: 0;
}

.info-value {
    font-size: 0.9rem;
    color: var(--forest);
    font-weight: 400;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
}

/* Badges */
.role-badge {
    background: var(--cream);
    color: var(--limeshadow);
    padding: 3px 11px;
    border-radius: 20px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    border: 1px solid var(--limelight);
}

.status-badge {
    padding: 4px 12px;
    border-radius: 20px;
    font-weight: 600;
    font-size: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    letter-spacing: 0.03em;
}
.status-active {
    background: rgba(39,174,96,0.09);
    color: var(--success);
    border: 1px solid rgba(39,174,96,0.25);
}
.status-disabled {
    background: rgba(192,57,43,0.08);
    color: var(--error);
    border: 1px solid rgba(192,57,43,0.2);
}
.status-archived {
    background: rgba(201,168,76,0.1);
    color: var(--gold);
    border: 1px solid rgba(201,168,76,0.25);
}

/* ── BUTTONS ── */
.btn-group {
    display: flex;
    gap: 10px;
    padding: 1.25rem 2rem;
    border-top: 1px solid rgba(29,74,35,0.07);
    background: var(--paper);
}

.btn {
    padding: 10px 22px;
    border: none;
    border-radius: 100px;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
}
.btn:active { transform: scale(0.97); }

.btn-primary {
    background: var(--forest);
    color: white;
    box-shadow: 0 2px 12px rgba(29,74,35,0.2);
}
.btn-primary:hover {
    background: var(--darkforest);
    box-shadow: 0 4px 18px rgba(29,74,35,0.28);
}

.btn-secondary {
    background: transparent;
    color: var(--midforest);
    border: 1px solid rgba(29,74,35,0.18);
}
.btn-secondary:hover { background: var(--cream); }
</style>

<div class="profile-page">
<div class="profile-wrapper">

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">
            <div class="alert-dot"></div>
            {{ message }}
        </div>
    {% endfor %}

    <!-- BANNER -->
    <div class="profile-banner">
        <div class="profile-banner-img"></div>
        <div class="profile-banner-overlay"></div>
        <div class="profile-banner-content">
            <div class="profile-avatar">👤</div>
            <div class="profile-banner-text">
                <h1>{{ user.username }}</h1>
                <p>Account Profile</p>
            </div>
        </div>
    </div>

    <!-- CARD -->
    <div class="profile-card">

        {% for message in app.flashes('success') %}
            <div class="alert alert-success" style="margin:1.5rem 2rem 0;">
                <div class="alert-dot"></div>{{ message }}
            </div>
        {% endfor %}

        <div class="profile-body">
            <div class="section-label">Account Details</div>

            <div class="info-row">
                <div class="info-icon">🔢</div>
                <div class="info-label">User ID</div>
                <div class="info-value">{{ user.id }}</div>
            </div>

            <div class="info-row">
                <div class="info-icon">👤</div>
                <div class="info-label">Username</div>
                <div class="info-value">{{ user.username }}</div>
            </div>

            <div class="info-row">
                <div class="info-icon">🛡️</div>
                <div class="info-label">Roles</div>
                <div class="info-value">
                    {% for role in user.roles %}
                        <span class="role-badge">{{ role }}</span>
                    {% endfor %}
                </div>
            </div>

            <div class="info-row">
                <div class="info-icon">✅</div>
                <div class="info-label">Status</div>
                <div class="info-value">
                    {% if user.isVerified %}
                        <span class="status-badge status-active">✓ Active</span>
                    {% else %}
                        <span class="status-badge status-disabled">⚠ Disabled</span>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="btn-group">
            <a href="{{ path('app_change_password') }}" class="btn btn-primary">🔒 Change Password</a>
            <a href="{{ path('app_dashboard') }}" class="btn btn-secondary">← Back to Dashboard</a>
        </div>
    </div>

</div>
</div>
{% endblock %}
