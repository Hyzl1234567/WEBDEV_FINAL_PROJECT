{% extends 'base.html.twig' %}

{% block title %}Change Password{% endblock %}

{% block body %}
<style>
    :root {
        --cream: #F0F7EC;
        --forest: #1D4A23;
        --darkforest: #142E17;
        --midforest: #2A6132;
        --lime: #99CC67;
        --limelight: #B8DC8E;
        --limeshadow: #7AAD4C;
        --paper: #F5FAF2;
        --leaf: #C8E8AD;
        --gold: #C9A84C;
        --amber: #D4863A;
        --error: #c0392b;
        --success: #27ae60;
    }

    .password-wrapper {
        max-width: 520px;
        margin: 3rem auto;
        padding: 0 1.5rem;
    }

    .password-card {
        background: white;
        border-radius: 20px;
        border: 1px solid rgba(29,74,35,0.10);
        overflow: hidden;
    }

    .password-header {
        background: linear-gradient(135deg, var(--forest) 0%, var(--midforest) 100%);
        padding: 2rem;
        text-align: center;
    }

    .header-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: rgba(153,204,103,0.2);
        border: 2px solid rgba(153,204,103,0.4);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        margin: 0 auto 0.9rem;
    }

    .password-header h1 {
        font-family: 'Playfair Display', serif;
        font-size: 1.35rem;
        font-weight: 700;
        color: white;
        margin-bottom: 0.25rem;
    }

    .password-header p {
        font-size: 0.78rem;
        color: rgba(255,255,255,0.5);
        letter-spacing: 0.05em;
    }

    .password-body {
        padding: 2rem;
        background: white;
    }

    .form-group {
        margin-bottom: 1.25rem;
    }

    .form-group label {
        display: block;
        font-size: 0.73rem;
        font-weight: 700;
        letter-spacing: 0.07em;
        text-transform: uppercase;
        color: var(--midforest);
        opacity: 0.8;
        margin-bottom: 0.5rem;
    }

    .form-group input[type="password"] {
        width: 100%;
        padding: 0.7rem 1rem;
        border: 1px solid rgba(29,74,35,0.18);
        border-radius: 10px;
        font-size: 0.92rem;
        color: var(--forest);
        background: var(--paper);
        box-sizing: border-box;
        transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    }

    .form-group input[type="password"]:focus {
        outline: none;
        border-color: var(--limeshadow);
        background: white;
        box-shadow: 0 0 0 3px rgba(153,204,103,0.18);
    }

    .form-divider {
        height: 1px;
        background: rgba(29,74,35,0.07);
        margin: 1.5rem 0;
    }

    .form-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 1.75rem;
    }

    .btn {
        padding: 11px 20px;
        border: none;
        border-radius: 10px;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.9rem;
        font-weight: 600;
        transition: background 0.2s, transform 0.15s;
        width: 100%;
        box-sizing: border-box;
    }

    .btn:active { transform: scale(0.98); }

    .btn-primary {
        background-color: var(--forest);
        color: white;
    }

    .btn-primary:hover { background-color: var(--midforest); }

    .btn-secondary {
        background-color: transparent;
        color: var(--midforest);
        border: 1px solid rgba(29,74,35,0.2);
    }

    .btn-secondary:hover { background-color: var(--cream); }

    .alert {
        padding: 11px 16px;
        border-radius: 10px;
        margin-bottom: 1.25rem;
        font-size: 0.855rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .alert::before {
        content: '';
        width: 6px;
        height: 6px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .alert-error {
        background: rgba(192,57,43,0.07);
        color: var(--error);
        border: 1px solid rgba(192,57,43,0.2);
    }

    .alert-error::before { background: var(--error); }

    .alert-success {
        background: rgba(39,174,96,0.08);
        color: var(--success);
        border: 1px solid rgba(39,174,96,0.22);
    }

    .alert-success::before { background: var(--success); }
</style>

<div class="password-wrapper">
    <div class="password-card">
        <div class="password-header">
            <div class="header-icon">🔒</div>
            <h1>Change Password</h1>
            <p>Update your account credentials</p>
        </div>

        <div class="password-body">

            {% for message in app.flashes('error') %}
                <div class="alert alert-error">{{ message }}</div>
            {% endfor %}

            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}

            <form method="post">
                <div class="form-group">
                    <label for="current_password">Current Password</label>
                    <input type="password" name="current_password" id="current_password" required>
                </div>

                <div class="form-divider"></div>

                <div class="form-group">
                    <label for="new_password">New Password</label>
                    <input type="password" name="new_password" id="new_password" required>
                </div>

                <div class="form-group">
                    <label for="confirm_password">Confirm New Password</label>
                    <input type="password" name="confirm_password" id="confirm_password" required>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Update Password</button>
                    <a href="{{ path('app_profile') }}" class="btn btn-secondary">Cancel</a>
                </div>
            </form>

        </div>
    </div>
</div>
{% endblock %}