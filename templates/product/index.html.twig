 {% extends 'dashboard/layout.html.twig' %}

{% block title %}Product index{% endblock %}

{% block body %}
<style>
  :root {
    --cream: #F0F7EC;
    --forest: #1D4A23;
    --darkforest: #142E17;
    --midforest: #2A6132;
    --lime: #99CC67;
    --limelight: #B8DC8E;
    --limeshadow: #7AAD4C;
    --paper: #F5FAF2;
    --leaf: #C8E8AD;
    --gold: #C9A84C;
    --amber: #D4863A;
  }

  .page-wrapper {
    min-height: 100vh;
    background: var(--cream);
    padding: 100px 2rem 3rem;
  }

  .page-inner {
    max-width: 1400px;
    margin: 0 auto;
  }

  /* ── Page Header ── */
  .page-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1.5px solid rgba(29,74,35,0.12);
  }

  .page-header-left h1 {
    font-family: 'Playfair Display', serif;
    font-size: 2rem;
    font-weight: 900;
    color: var(--forest);
    margin-bottom: 0.2rem;
  }

  .page-header-left p {
    font-size: 0.88rem;
    color: var(--midforest);
    opacity: 0.7;
  }

  /* ── Alert ── */
  .alert {
    padding: 12px 20px;
    border-radius: 10px;
    margin-bottom: 1.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .alert-success {
    background: rgba(153,204,103,0.2);
    color: var(--forest);
    border: 1px solid rgba(153,204,103,0.5);
  }

  .alert-error {
    background: rgba(192,57,43,0.08);
    color: #c0392b;
    border: 1px solid rgba(192,57,43,0.2);
  }

  /* ── Add button ── */
  .btn-add {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 22px;
    background: var(--forest);
    color: white;
    border-radius: 50px;
    text-decoration: none;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.2px;
    box-shadow: 0 4px 18px rgba(29,74,35,0.22);
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
  }

  .btn-add:hover {
    background: var(--lime);
    color: var(--forest);
    transform: translateY(-2px);
    box-shadow: 0 8px 26px rgba(153,204,103,0.35);
  }

  /* ── Card ── */
  .table-card {
    background: white;
    border-radius: 18px;
    box-shadow: 0 4px 32px rgba(29,74,35,0.08);
    overflow: hidden;
  }

  /* ── DataTable Controls ── */
  .dataTables_wrapper {
    padding: 1.5rem;
  }

  .dataTables_filter label,
  .dataTables_length label {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    color: var(--midforest);
    font-weight: 500;
  }

  .dataTables_filter input {
    border: 1.5px solid rgba(29,74,35,0.2) !important;
    border-radius: 8px !important;
    padding: 7px 13px !important;
    margin-left: 8px !important;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    color: var(--forest);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .dataTables_filter input:focus {
    border-color: var(--lime) !important;
    box-shadow: 0 0 0 3px rgba(153,204,103,0.15) !important;
  }

  .dataTables_length select {
    border: 1.5px solid rgba(29,74,35,0.2) !important;
    border-radius: 8px !important;
    padding: 5px 10px !important;
    margin: 0 6px !important;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    color: var(--forest);
  }

  /* ── Table ── */
  table {
    width: 100% !important;
    border-collapse: collapse;
  }

  thead {
    background: var(--forest);
  }

  thead th {
    padding: 14px 16px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.8px;
    text-transform: uppercase;
    color: rgba(240,247,236,0.85);
    border: none;
  }

  tbody tr {
    border-bottom: 1px solid rgba(29,74,35,0.07);
    transition: background 0.15s;
  }

  tbody tr:hover {
    background: var(--paper);
  }

  tbody tr:last-child {
    border-bottom: none;
  }

  td {
    padding: 13px 16px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    color: var(--forest);
    vertical-align: middle;
    border: none;
  }

  td strong {
    font-weight: 600;
  }

  /* ── Product Image ── */
  table img {
    width: 68px;
    height: 68px;
    object-fit: cover;
    border-radius: 10px;
    box-shadow: 0 2px 10px rgba(29,74,35,0.12);
  }

  .no-image {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    border-radius: 10px;
    background: var(--cream);
    color: rgba(29,74,35,0.35);
    font-size: 0.75rem;
    font-style: italic;
    border: 1.5px dashed rgba(29,74,35,0.2);
  }

  /* ── Category Badge ── */
  .category-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 50px;
    font-size: 0.78rem;
    font-weight: 600;
    background: rgba(153,204,103,0.18);
    color: var(--midforest);
    border: 1px solid rgba(153,204,103,0.4);
    letter-spacing: 0.2px;
  }

  /* ── User Badge ── */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 11px;
    border-radius: 50px;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .badge-admin {
    background: rgba(155,89,182,0.12);
    color: #7d3c98;
    border: 1px solid rgba(155,89,182,0.25);
  }

  .badge-staff {
    background: rgba(52,152,219,0.1);
    color: #1a6fa8;
    border: 1px solid rgba(52,152,219,0.25);
  }

  .badge-unknown {
    background: rgba(149,165,166,0.15);
    color: #666;
    border: 1px solid rgba(149,165,166,0.3);
  }

  /* ── Action Buttons ── */
  .actions-cell {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .btn-action {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 13px;
    border-radius: 8px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.18s;
    white-space: nowrap;
    letter-spacing: 0.1px;
  }

  .btn-show {
    background: rgba(153,204,103,0.15);
    color: var(--midforest);
    border: 1.5px solid rgba(153,204,103,0.45);
  }

  .btn-show:hover {
    background: var(--lime);
    color: var(--forest);
    border-color: var(--lime);
  }

  .btn-edit {
    background: var(--forest);
    color: white;
    border: 1.5px solid var(--forest);
  }

  .btn-edit:hover {
    background: var(--midforest);
    border-color: var(--midforest);
  }

  .btn-delete {
    background: rgba(192,57,43,0.08);
    color: #c0392b;
    border: 1.5px solid rgba(192,57,43,0.25);
  }

  .btn-delete:hover {
    background: #c0392b;
    color: white;
    border-color: #c0392b;
  }

  .btn-locked {
    background: rgba(189,195,199,0.2);
    color: #aab;
    border: 1.5px solid rgba(189,195,199,0.4);
    cursor: not-allowed;
    opacity: 0.65;
  }

  .delete-form {
    display: inline;
    margin: 0;
  }

  /* ── Pagination ── */
  .dataTables_paginate {
    margin-top: 1rem;
  }

  .dataTables_paginate .paginate_button {
    padding: 6px 13px !important;
    margin: 0 2px !important;
    border-radius: 8px !important;
    border: 1.5px solid rgba(29,74,35,0.18) !important;
    background: white !important;
    color: var(--forest) !important;
    font-family: 'DM Sans', sans-serif !important;
    font-size: 0.85rem !important;
    font-weight: 500 !important;
    transition: all 0.15s !important;
    cursor: pointer;
  }

  .dataTables_paginate .paginate_button:hover {
    background: var(--forest) !important;
    color: white !important;
    border-color: var(--forest) !important;
  }

  .dataTables_paginate .paginate_button.current {
    background: var(--forest) !important;
    color: white !important;
    border-color: var(--forest) !important;
  }

  .dataTables_paginate .paginate_button.disabled {
    color: rgba(29,74,35,0.3) !important;
    border-color: rgba(29,74,35,0.1) !important;
    cursor: default !important;
  }

  .dataTables_info {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.83rem;
    color: rgba(29,74,35,0.55);
    margin-top: 1rem;
  }

  td.dataTables_empty {
    text-align: center;
    color: rgba(29,74,35,0.4);
    font-style: italic;
    padding: 3rem !important;
    font-size: 0.9rem;
  }
</style>

<div class="page-wrapper">
  <div class="page-inner">

    {% for message in app.flashes('success') %}
      <div class="alert alert-success">✓ {{ message }}</div>
    {% endfor %}
    {% for message in app.flashes('error') %}
      <div class="alert alert-error">⚠ {{ message }}</div>
    {% endfor %}

    <div class="page-header">
      <div class="page-header-left">
        <h1>Product List</h1>
        <p>Manage your café's product catalogue</p>
      </div>
      <a class="btn-add" href="{{ path('app_product_new') }}">
        + Add New Product
      </a>
    </div>

    <div class="table-card">
      <table id="productsTable">
        <thead>
          <tr>
            <th>Id</th>
            <th>Product</th>
            <th>Image</th>
            <th>Category</th>
            <th>Description</th>
            <th>Qty</th>
            <th>Price</th>
            <th>Created By</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
        {% for product in products %}
          <tr>
            <td style="opacity:0.5; font-size:0.8rem;">#{{ product.id }}</td>
            <td><strong>{{ product.name }}</strong></td>
            <td>
              {% if product.image %}
                <img src="{{ asset('uploads/images/' ~ product.image) }}" alt="{{ product.name }}">
              {% else %}
                <span class="no-image">No image</span>
              {% endif %}
            </td>
            <td><span class="category-badge">{{ product.category }}</span></td>
            <td style="max-width:200px; color: rgba(29,74,35,0.7); font-size:0.875rem;">
              {{ product.description|slice(0, 50) }}{{ product.description|length > 50 ? '…' : '' }}
            </td>
            <td><strong>{{ product.quantity }}</strong></td>
            <td><strong>₱{{ product.price|number_format(2, '.', ',') }}</strong></td>
            <td>
              {% if product.createdBy %}
                <span class="badge {{ 'ROLE_ADMIN' in product.createdBy.roles ? 'badge-admin' : 'badge-staff' }}">
                  {{ 'ROLE_ADMIN' in product.createdBy.roles ? '👑' : '👤' }} {{ product.createdBy.username }}
                </span>
              {% else %}
                <span class="badge badge-unknown">Unknown</span>
              {% endif %}
            </td>
            <td>
              <div class="actions-cell">
                <a href="{{ path('app_product_show', {'id': product.id}) }}" class="btn-action btn-show">👁 Show</a>

                {% set canEdit = is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}

                {% if canEdit %}
                  <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="btn-action btn-edit">✏️ Edit</a>
                  <form method="post" action="{{ path('app_product_delete', {'id': product.id}) }}" class="delete-form"
                        onsubmit="return confirm('⚠️ Are you sure you want to delete this product?\n\nProduct: {{ product.name }}\nPrice: ₱{{ product.price|number_format(2) }}\n\nThis action cannot be undone!');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                    <button type="submit" class="btn-action btn-delete">🗑 Delete</button>
                  </form>
                {% else %}
                  <span class="btn-action btn-locked" title="You can only edit your own records">🔒 Locked</span>
                {% endif %}
              </div>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="9" class="no-records">No records found</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>

  </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
$(document).ready(function() {
    $('#productsTable').DataTable({
        "order": [[0, "desc"]],
        "pageLength": 10,
        "lengthMenu": [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
        "language": {
            "search": "🔍 Search:",
            "lengthMenu": "Show _MENU_ entries",
            "info": "Showing _START_ to _END_ of _TOTAL_ products",
            "infoEmpty": "No products available",
            "infoFiltered": "(filtered from _MAX_ total products)",
            "zeroRecords": "No matching products found",
            "emptyTable": "No products available in table",
            "paginate": {
                "first": "First",
                "last": "Last",
                "next": "Next",
                "previous": "Previous"
            }
        },
        "columnDefs": [
            { "orderable": false, "targets": [2, 8] },
            { "type": "num", "targets": [5, 6] }
        ]
    });
});
</script>
{% endblock %}
