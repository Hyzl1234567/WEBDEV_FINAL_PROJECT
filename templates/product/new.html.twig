 {% extends 'base.html.twig' %}

{% block title %}New Product{% endblock %}

{% block body %}
<style>
  :root {
    --cream: #F0F7EC;
    --forest: #1D4A23;
    --darkforest: #142E17;
    --midforest: #2A6132;
    --lime: #99CC67;
    --limelight: #B8DC8E;
    --paper: #F5FAF2;
  }

  .form-page {
    min-height: 100vh;
    background: var(--cream);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 100px 1.5rem 3rem;
  }

  .form-card {
    width: 100%;
    max-width: 600px;
    background: white;
    border-radius: 22px;
    box-shadow: 0 8px 48px rgba(29,74,35,0.12);
    overflow: hidden;
  }

  /* ── Card Header ── */
  .form-card-header {
    background: var(--forest);
    padding: 2rem 2.25rem 1.75rem;
  }

  .form-card-header h2 {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    font-weight: 900;
    color: white;
    margin-bottom: 0.25rem;
  }

  .form-card-header p {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    color: rgba(240,247,236,0.6);
  }

  /* ── Card Body ── */
  .form-card-body {
    padding: 2rem 2.25rem;
  }

  /* ── Field groups (from base theme) ── */
  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-group label {
    display: block;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--forest);
    margin-bottom: 0.45rem;
    letter-spacing: 0.3px;
  }

  .form-group input,
  .form-group select,
  .form-group textarea,
  form input[type="text"],
  form input[type="number"],
  form input[type="file"],
  form textarea,
  form select {
    width: 100%;
    padding: 12px 16px;
    border: 1.5px solid rgba(29,74,35,0.2);
    border-radius: 10px;
    background: var(--paper);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    color: var(--forest);
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
    margin-bottom: 0;
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus,
  form input[type="text"]:focus,
  form input[type="number"]:focus,
  form textarea:focus,
  form select:focus {
    border-color: var(--lime);
    box-shadow: 0 0 0 3px rgba(153,204,103,0.18);
    background: white;
  }

  form input[type="file"] {
    padding: 10px 14px;
    cursor: pointer;
    font-size: 0.875rem;
    color: rgba(29,74,35,0.7);
  }

  form textarea {
    resize: vertical;
    min-height: 100px;
    line-height: 1.6;
  }

  /* Symfony renders labels outside .form-group sometimes */
  form label {
    display: block;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--forest);
    margin-bottom: 0.45rem;
    margin-top: 1.1rem;
    letter-spacing: 0.3px;
  }

  form label:first-child { margin-top: 0; }

  /* ── Readonly ── */
  .readonly-field {
    background: rgba(29,74,35,0.05) !important;
    color: rgba(29,74,35,0.5) !important;
    cursor: not-allowed !important;
    border-color: rgba(29,74,35,0.12) !important;
  }

  /* ── Divider ── */
  .form-divider {
    height: 1px;
    background: rgba(29,74,35,0.08);
    margin: 1.75rem 0;
  }

  /* ── Buttons ── */
  .form-buttons {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1.5px solid rgba(29,74,35,0.08);
    gap: 0.75rem;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 11px 24px;
    background: transparent;
    color: var(--midforest);
    border: 1.5px solid rgba(29,74,35,0.25);
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.2s;
  }

  .back-btn:hover {
    background: var(--forest);
    color: white;
    border-color: var(--forest);
  }

  .save-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 12px 28px;
    background: var(--forest);
    color: white;
    border: none;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    letter-spacing: 0.2px;
    box-shadow: 0 4px 18px rgba(29,74,35,0.25);
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
  }

  .save-btn:hover {
    background: var(--lime);
    color: var(--forest);
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(153,204,103,0.35);
  }
</style>

<div class="form-page">
  <div class="form-card">

    <div class="form-card-header">
      <h2>Add New Product</h2>
      <p>Fill in the details to add a product to the catalogue</p>
    </div>

    <div class="form-card-body">
      {{ include('product/_form.html.twig') }}
    </div>

  </div>
</div>

{% endblock %}
