 {% extends 'base.html.twig' %}

{% block title %}Edit Product{% endblock %}

{% block body %}
<style>
  :root {
    --cream: #F0F7EC;
    --forest: #1D4A23;
    --darkforest: #142E17;
    --midforest: #2A6132;
    --lime: #99CC67;
    --limelight: #B8DC8E;
    --paper: #F5FAF2;
  }

  .form-page {
    min-height: 100vh;
    background: var(--cream);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 100px 1.5rem 3rem;
  }

  .form-card {
    width: 100%;
    max-width: 620px;
    background: white;
    border-radius: 22px;
    box-shadow: 0 8px 48px rgba(29,74,35,0.12);
    overflow: hidden;
  }

  /* ── Card Header ── */
  .form-card-header {
    background: var(--forest);
    padding: 2rem 2.25rem 1.75rem;
  }

  .form-card-header h1 {
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    font-weight: 900;
    color: white;
    margin-bottom: 0.25rem;
  }

  .form-card-header p {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    color: rgba(240,247,236,0.6);
  }

  /* ── Card Body ── */
  .form-card-body {
    padding: 2rem 2.25rem;
  }

  /* ── Alerts ── */
  .alert {
    padding: 11px 16px;
    border-radius: 10px;
    margin-bottom: 1.1rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .alert-success {
    background: rgba(153,204,103,0.18);
    color: var(--forest);
    border: 1px solid rgba(153,204,103,0.45);
  }

  .alert-error {
    background: rgba(192,57,43,0.08);
    color: #c0392b;
    border: 1px solid rgba(192,57,43,0.2);
  }

  /* ── Creator info ── */
  .creator-info {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 16px;
    background: var(--paper);
    border: 1px solid rgba(29,74,35,0.1);
    border-radius: 10px;
    margin-bottom: 1.5rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    color: var(--midforest);
    font-weight: 500;
  }

  /* ── Badges ── */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 11px;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .badge-admin {
    background: rgba(155,89,182,0.12);
    color: #7d3c98;
    border: 1px solid rgba(155,89,182,0.25);
  }

  .badge-staff {
    background: rgba(52,152,219,0.1);
    color: #1a6fa8;
    border: 1px solid rgba(52,152,219,0.25);
  }

  /* ── Form fields ── */
  .readonly-field {
    background: rgba(29,74,35,0.05) !important;
    color: rgba(29,74,35,0.45) !important;
    cursor: not-allowed !important;
    border-color: rgba(29,74,35,0.12) !important;
  }

  form {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  label {
    display: block;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--forest);
    margin-bottom: 0.4rem;
    margin-top: 1.1rem;
    letter-spacing: 0.3px;
  }

  label:first-of-type { margin-top: 0; }

  input,
  textarea,
  select {
    width: 100%;
    padding: 12px 16px;
    border: 1.5px solid rgba(29,74,35,0.2);
    border-radius: 10px;
    background: var(--paper);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.95rem;
    color: var(--forest);
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
  }

  input:focus,
  textarea:focus,
  select:focus {
    border-color: var(--lime);
    box-shadow: 0 0 0 3px rgba(153,204,103,0.18);
    background: white;
  }

  textarea { resize: vertical; min-height: 100px; line-height: 1.6; }

  /* ── Submit button (inside Symfony form) ── */
  button[type="submit"] {
    width: 100%;
    margin-top: 1.5rem;
    padding: 13px;
    background: var(--forest);
    color: white;
    border: none;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    letter-spacing: 0.2px;
    box-shadow: 0 4px 18px rgba(29,74,35,0.22);
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
  }

  button[type="submit"]:hover {
    background: var(--lime);
    color: var(--forest);
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(153,204,103,0.35);
  }

  /* ── Bottom action row ── */
  .form-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1.5px solid rgba(29,74,35,0.08);
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 10px 22px;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    border: 1.5px solid rgba(29,74,35,0.25);
    background: transparent;
    color: var(--midforest);
    transition: all 0.2s;
  }

  .btn:hover {
    background: var(--forest);
    color: white;
    border-color: var(--forest);
  }

  .delete-form {
    display: inline;
    margin: 0;
  }

  .delete-form button {
    width: auto;
    margin-top: 0;
    padding: 10px 22px;
    background: rgba(192,57,43,0.08);
    color: #c0392b;
    border: 1.5px solid rgba(192,57,43,0.25);
    border-radius: 50px;
    font-size: 0.875rem;
    font-weight: 600;
    box-shadow: none;
    letter-spacing: 0;
  }

  .delete-form button:hover {
    background: #c0392b;
    color: white;
    border-color: #c0392b;
    transform: none;
    box-shadow: none;
  }
</style>

<div class="form-page">
  <div class="form-card">

    <div class="form-card-header">
      <h1>✏️ Edit Product</h1>
      <p>Update the details for this product</p>
    </div>

    <div class="form-card-body">

      {% for message in app.flashes('success') %}
        <div class="alert alert-success">✓ {{ message }}</div>
      {% endfor %}
      {% for message in app.flashes('error') %}
        <div class="alert alert-error">⚠ {{ message }}</div>
      {% endfor %}

      {% if product.createdBy %}
        <div class="creator-info">
          Created by:
          <span class="badge {{ 'ROLE_ADMIN' in product.createdBy.roles ? 'badge-admin' : 'badge-staff' }}">
            {{ 'ROLE_ADMIN' in product.createdBy.roles ? '👑 ' : '👤 ' }}{{ product.createdBy.username }}
          </span>
        </div>
      {% endif %}

      {{ form_start(form) }}
        {{ form_widget(form) }}
        <button type="submit">💾 Update Product</button>
      {{ form_end(form) }}

      <div class="form-actions">
        <a href="{{ path('app_product_index') }}" class="btn">← Back</a>

        {% set canDelete = is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}

        {% if canDelete %}
          <form method="post" action="{{ path('app_product_delete', {'id': product.id}) }}" class="delete-form"
                onsubmit="return confirm('⚠️ Are you sure you want to delete this product?\n\nProduct: {{ product.name }}\nPrice: ₱{{ product.price|number_format(2) }}\n\nThis action cannot be undone!');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
            <button type="submit">🗑️ Delete Product</button>
          </form>
        {% endif %}
      </div>

    </div>
  </div>
</div>

{% endblock %}
