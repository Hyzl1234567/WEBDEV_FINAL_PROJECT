 {% extends 'base.html.twig' %}

{% block title %}Product{% endblock %}

{% block body %}
<style>
  :root {
    --cream: #F0F7EC;
    --forest: #1D4A23;
    --darkforest: #142E17;
    --midforest: #2A6132;
    --lime: #99CC67;
    --limelight: #B8DC8E;
    --paper: #F5FAF2;
  }

  .show-page {
    min-height: 100vh;
    background: var(--cream);
    padding: 100px 1.5rem 3rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-show-container {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    max-width: 960px;
    width: 100%;
    background: white;
    border-radius: 22px;
    box-shadow: 0 8px 48px rgba(29,74,35,0.12);
    overflow: hidden;
  }

  /* ── Left: Image ── */
  .product-left {
    background: var(--darkforest);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2.5rem;
    border-right: 1.5px solid rgba(29,74,35,0.07);
    min-height: 420px;
  }

  .product-left img {
    max-width: 100%;
    max-height: 360px;
    object-fit: contain;
    border-radius: 12px;
    box-shadow: 0 4px 24px rgba(29,74,35,0.1);
  }

  .no-image-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    color: rgba(29,74,35,0.35);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    font-style: italic;
  }

  .no-image-placeholder span {
    font-size: 2.5rem;
  }

  /* ── Right: Details ── */
  .product-right {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .product-right h2 {
    font-family: 'Playfair Display', serif;
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--forest);
    margin-bottom: 0.5rem;
    line-height: 1.25;
  }

  .product-description {
    font-family: 'DM Sans', sans-serif;
    font-size: 0.9rem;
    line-height: 1.7;
    color: rgba(29,74,35,0.65);
  }

  /* ── Details list ── */
  .product-details {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.25rem;
    background: var(--paper);
    border-radius: 12px;
    border: 1px solid rgba(29,74,35,0.08);
  }

  .detail {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    color: var(--forest);
  }

  .detail-label {
    font-weight: 700;
    font-size: 0.78rem;
    letter-spacing: 0.4px;
    color: rgba(29,74,35,0.5);
    text-transform: uppercase;
    min-width: 90px;
  }

  .detail-value {
    color: var(--forest);
    font-weight: 500;
  }

  /* ── Price ── */
  .product-price {
    font-family: 'Playfair Display', serif;
    font-size: 2.2rem;
    font-weight: 900;
    color: var(--forest);
    letter-spacing: -0.5px;
  }

  /* ── Badges ── */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 11px;
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
  }

  .badge-admin {
    background: rgba(155,89,182,0.12);
    color: #7d3c98;
    border: 1px solid rgba(155,89,182,0.25);
  }

  .badge-staff {
    background: rgba(52,152,219,0.1);
    color: #1a6fa8;
    border: 1px solid rgba(52,152,219,0.25);
  }

  .badge-unknown {
    background: rgba(149,165,166,0.15);
    color: #666;
    border: 1px solid rgba(149,165,166,0.3);
  }

  .category-badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 50px;
    font-size: 0.78rem;
    font-weight: 600;
    background: rgba(153,204,103,0.18);
    color: var(--midforest);
    border: 1px solid rgba(153,204,103,0.4);
  }

  /* ── Action Buttons ── */
  .product-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    padding-top: 1.25rem;
    border-top: 1.5px solid rgba(29,74,35,0.08);
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 10px 20px;
    background: transparent;
    color: var(--midforest);
    border: 1.5px solid rgba(29,74,35,0.25);
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s;
  }

  .back-btn:hover {
    background: var(--forest);
    color: white;
    border-color: var(--forest);
  }

  .edit-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 10px 20px;
    background: var(--forest);
    color: white;
    border: 1.5px solid var(--forest);
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s;
    box-shadow: 0 3px 14px rgba(29,74,35,0.2);
  }

  .edit-btn:hover {
    background: var(--lime);
    color: var(--forest);
    border-color: var(--lime);
    box-shadow: 0 6px 20px rgba(153,204,103,0.3);
  }

  .delete-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 10px 20px;
    background: rgba(192,57,43,0.08);
    color: #c0392b;
    border: 1.5px solid rgba(192,57,43,0.25);
    border-radius: 50px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
  }

  .delete-btn:hover {
    background: #c0392b;
    color: white;
    border-color: #c0392b;
  }

  .delete-form {
    display: inline;
    margin: 0;
  }

  /* ── Warning ── */
  .warning-message {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 12px 16px;
    background: rgba(212,163,58,0.1);
    border: 1px solid rgba(212,163,58,0.3);
    border-radius: 10px;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.83rem;
    color: #7a5c00;
    margin-top: 0.5rem;
  }

  /* ── Responsive ── */
  @media (max-width: 700px) {
    .product-show-container { grid-template-columns: 1fr; }
    .product-left { border-right: none; border-bottom: 1.5px solid rgba(29,74,35,0.07); min-height: 240px; }
  }
</style>

<div class="show-page">
  <div class="product-show-container">

    <div class="product-left">
      {% if product.image %}
        <img src="{{ asset('uploads/images/' ~ product.image) }}" alt="{{ product.name }}">
      {% else %}
        <div class="no-image-placeholder">
          <span>🖼</span>
          No image available
        </div>
      {% endif %}
    </div>

    <div class="product-right">
      <div>
        <h2>{{ product.name }}</h2>
        <p class="product-description">{{ product.description }}</p>
      </div>

      <div class="product-details">
        <div class="detail">
          <span class="detail-label">ID</span>
          <span class="detail-value">#{{ product.id }}</span>
        </div>
        <div class="detail">
          <span class="detail-label">Category</span>
          <span class="category-badge">{{ product.category }}</span>
        </div>
        <div class="detail">
          <span class="detail-label">Quantity</span>
          <span class="detail-value">{{ product.quantity }}</span>
        </div>
        <div class="detail">
          <span class="detail-label">Created</span>
          <span class="detail-value">{{ product.createdAt ? product.createdAt|date('F d, Y') : '—' }}</span>
        </div>
        <div class="detail">
          <span class="detail-label">Created By</span>
          {% if product.createdBy %}
            <span class="badge {{ 'ROLE_ADMIN' in product.createdBy.roles ? 'badge-admin' : 'badge-staff' }}">
              {{ 'ROLE_ADMIN' in product.createdBy.roles ? '👑 Admin' : '👤 Staff' }} — {{ product.createdBy.username }}
            </span>
          {% else %}
            <span class="badge badge-unknown">Unknown</span>
          {% endif %}
        </div>
      </div>

      <p class="product-price">₱{{ product.price|number_format(2, '.', ',') }}</p>

      <div class="product-actions">
        <a href="{{ path('app_product_index') }}" class="back-btn">⬅ Back</a>

        {% set canEdit = is_granted('ROLE_ADMIN') or is_granted('ROLE_STAFF') %}

        {% if canEdit %}
          <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="edit-btn">✏ Edit</a>
          <form method="post" action="{{ path('app_product_delete', {'id': product.id}) }}" class="delete-form"
                onsubmit="return confirm('⚠️ Are you sure you want to delete this product?\n\nProduct: {{ product.name }}\nPrice: ₱{{ product.price|number_format(2) }}\n\nThis action cannot be undone!');">
            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
            <button type="submit" class="delete-btn">🗑️ Delete</button>
          </form>
        {% endif %}
      </div>

      {% if not canEdit %}
        <div class="warning-message">
          🔒 You can only edit or delete your own records. This product was created by
          {% if product.createdBy %}
            <strong>{{ product.createdBy.username }}</strong>
          {% else %}
            <strong>another user</strong>
          {% endif %}.
        </div>
      {% endif %}
    </div>

  </div>
</div>

{% endblock %}
